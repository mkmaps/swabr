    "Löst hängende Verbindungen nach Netzwechseln. Die Verbindung ist dabei wenige Sekunden unterbrochen, laufende Downloads können abbrechen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opraví zaseknutá připojení po změně sítě. Připojení se na několik sekund přeruší; běžící stahování mohou selhat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löst hängende Verbindungen nach Netzwechseln. Die Verbindung ist dabei wenige Sekunden unterbrochen, laufende Downloads können abbrechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώνει κολλημένες συνδέσεις μετά από αλλαγή δικτύου. Η σύνδεση διακόπτεται για λίγα δευτερόλεπτα· λήψεις σε εξέλιξη μπορεί να αποτύχουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes hanging connections after switching networks. The connection drops for a few seconds; running downloads may fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soluciona los problemas de conexión tras cambiar de red. La conexión se interrumpe durante unos segundos; las descargas en curso pueden fallar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les problèmes de connexion bloquée après un changement de réseau. La connexion est interrompue pendant quelques secondes ; les téléchargements en cours peuvent échouer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravlja zapele veze nakon promjene mreže. Veza se prekida na nekoliko sekundi; preuzimanja u tijeku mogu ne uspjeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megoldja a hálózatváltás utáni elakadt kapcsolatokat. A kapcsolat néhány másodpercre megszakad; a futó letöltések megszakadhatnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolve il problema delle connessioni che si bloccano dopo aver cambiato rete. La connessione si interrompe per qualche secondo; i download in corso potrebbero non andare a buon fine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige o problema de conexões que ficam bloqueadas após a mudança de rede. A conexão é interrompida durante alguns segundos; os downloads em curso podem falhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Repară conexiunile blocate după schimbarea rețelei. Conexiunea cade câteva secunde; descărcările în curs pot eșua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opraví zaseknuté pripojenia po zmene siete. Pripojenie sa na niekoľko sekúnd preruší; prebiehajúce sťahovania môžu zlyhať."
          }
        }
      }
    },
