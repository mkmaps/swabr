    "Keine versteckten Finder-Dateien mehr auf NAS, Freigaben und USB-Sticks. Ordneransichten dort merkt sich der Finder dann nicht mehr.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už žádné skryté soubory Finderu na NAS, sdílených složkách a USB discích. Finder si tam pak nepamatuje zobrazení složek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine versteckten Finder-Dateien mehr auf NAS, Freigaben und USB-Sticks. Ordneransichten dort merkt sich der Finder dann nicht mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όχι πλέον κρυφά αρχεία Finder σε NAS, κοινόχρηστους φακέλους και USB. Το Finder δεν θυμάται πλέον εκεί τις προβολές φακέλων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more hidden Finder files on NAS, shares and USB sticks. The Finder then no longer remembers folder views there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acabaron los archivos ocultos del Finder en NAS, recursos compartidos y memorias USB. Así, el Finder ya no recordará las vistas de carpetas de esos lugares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fini les fichiers cachés du Finder sur les NAS, les partages et les clés USB. Le Finder ne mémorise alors plus les affichages de dossiers à ces emplacements."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema više skrivenih Finder datoteka na NAS-u, dijeljenim mapama i USB stickovima. Finder tamo više ne pamti prikaze mapa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs több rejtett Finder-fájl NAS-on, megosztásokon és USB-meghajtókon. A Finder ott ezután nem jegyzi meg a mappanézeteket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente più file nascosti nel Finder su NAS, condivisioni e chiavette USB. Il Finder non ricorderà più le visualizzazioni delle cartelle in quelle posizioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabaram-se os ficheiros ocultos do Finder em NAS, partilhas e pen drives. O Finder deixa então de memorizar as visualizações das pastas nesses locais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai apar fișiere Finder ascunse pe NAS, partajări și stick-uri USB. Finder nu mai reține acolo vizualizările dosarelor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už žiadne skryté súbory Findera na NAS, zdieľaných priečinkoch a USB kľúčoch. Finder si tam potom nepamätá zobrazenia priečinkov."
          }
        }
      }
    },
    "Kernel-Erweiterung. Wird erst nach einem Neustart vollständig entfernt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozšíření jádra. Zcela se odstraní až po restartu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernel-Erweiterung. Wird erst nach einem Neustart vollständig entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επέκταση πυρήνα. Αφαιρείται πλήρως μόνο μετά από επανεκκίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernel extension. Removed completely only after a restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensión del kernel. Solo se elimina por completo tras reiniciar el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension du noyau. N'est supprimée définitivement qu'après un redémarrage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proširenje jezgre. Potpuno se uklanja tek nakon ponovnog pokretanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernelbővítmény. Csak újraindítás után távolítódik el teljesen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estensione del kernel. Viene rimossa completamente solo dopo un riavvio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensão do kernel. Só é removida completamente após um reinício."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensie de kernel. Eliminată complet doar după o repornire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozšírenie jadra. Úplne sa odstráni až po reštarte."
          }
        }
      }
    },
