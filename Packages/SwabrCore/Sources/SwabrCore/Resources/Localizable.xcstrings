    "Nur Protokolle. Hilft bei Fehlersuche, wird sonst nicht benötigt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen logy. Pomáhají při hledání chyb, jinak nejsou potřeba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Protokolle. Hilft bei Fehlersuche, wird sonst nicht benötigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο αρχεία καταγραφής. Χρήσιμα για αντιμετώπιση προβλημάτων, αλλιώς δεν χρειάζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs only. Useful for troubleshooting, otherwise not needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo registros. Útiles para solucionar problemas; si no, no son necesarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux uniquement. Utile pour le dépannage, sinon inutile."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo zapisi. Korisni za rješavanje problema, inače nepotrebni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak naplók. Hibakereséshez hasznosak, egyébként nincs rájuk szükség."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo log. Utili per la risoluzione dei problemi, altrimenti non servono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas registos. Útil para a resolução de problemas; caso contrário, não é necessário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar jurnale. Utile pentru depanare, altfel nu sunt necesare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len logy. Pomáhajú pri hľadaní chýb, inak nie sú potrebné."
          }
        }
      }
    },
