    "macOS nutzt wieder seine Standardwerte: Apps im Hintergrund sparen Energie, Festplattenimages werden geprüft.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS opět používá výchozí hodnoty: aplikace na pozadí šetří energii, obrazy disků se ověřují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nutzt wieder seine Standardwerte: Apps im Hintergrund sparen Energie, Festplattenimages werden geprüft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS χρησιμοποιεί ξανά τις προεπιλογές του: οι εφαρμογές παρασκηνίου εξοικονομούν ενέργεια, τα είδωλα δίσκων επαληθεύονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS uses its defaults again: background apps save energy, disk images are verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vuelve a usar sus ajustes predeterminados: las apps en segundo plano ahorran energía y las imágenes de disco se verifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS utilise à nouveau ses paramètres par défaut : les applications en arrière-plan permettent d'économiser de l'énergie, les images disque sont vérifiées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ponovno koristi svoje zadane postavke: pozadinske aplikacije štede energiju, slike diska se provjeravaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS ismét az alapértékeit használja: a háttérben futó appok energiát takarítanak meg, a lemezképek ellenőrzésre kerülnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS usa di nuovo le sue impostazioni predefinite: le app in background risparmiano energia, le immagini disco vengono verificate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS volta a utilizar as suas predefinições: as aplicações em segundo plano poupam energia e as imagens de disco são verificadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS folosește din nou valorile implicite: aplicațiile de fundal economisesc energie, imaginile de disc sunt verificate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS opäť používa predvolené hodnoty: aplikácie na pozadí šetria energiu, obrazy diskov sa overujú."
          }
        }
      }
    },
