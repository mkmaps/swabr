    "Ältere Einträge verschwinden aus der Mitteilungszentrale. Die Mitteilungsanzeige startet kurz neu.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Starší položky zmizí z Oznamovacího centra. Zobrazení oznámení se krátce restartuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Einträge verschwinden aus der Mitteilungszentrale. Die Mitteilungsanzeige startet kurz neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παλαιότερες καταχωρίσεις εξαφανίζονται από το Κέντρο γνωστοποιήσεων. Η εμφάνιση γνωστοποιήσεων επανεκκινείται για λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older entries disappear from Notification Centre. The notification display restarts briefly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas más antiguas desaparecen del Centro de notificaciones. La pantalla de notificaciones se reinicia brevemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes notifications disparaissent du Centre de notifications. L'affichage des notifications redémarre brièvement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stariji unosi nestaju iz Centra za obavijesti. Prikaz obavijesti nakratko se ponovno pokreće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A régebbi bejegyzések eltűnnek az Értesítési központból. Az értesítések megjelenítése röviden újraindul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche più vecchie scompaiono dal Centro Notifiche. La visualizzazione delle notifiche si riavvia brevemente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As entradas mais antigas desaparecem do Centro de Notificações. A exibição das notificações reinicia-se brevemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intrările mai vechi dispar din Centrul de notificări. Afișarea notificărilor repornește scurt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Staršie položky zmiznú z Centra hlásení. Zobrazenie hlásení sa krátko reštartuje."
          }
        }
      }
    },
    "Ältere JetBrains-Versionen": {
      "localizations": {
