    "Cache mit Inhalten von bleibendem Wert (z. B. Offline-Musik oder Verlauf). Nur gezielt löschen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezipaměť s trvalým obsahem (např. offline hudba nebo historie). Mažte jen cíleně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache mit Inhalten von bleibendem Wert (z. B. Offline-Musik oder Verlauf). Nur gezielt löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσωρινή μνήμη με μόνιμο περιεχόμενο (π.χ. μουσική εκτός σύνδεσης ή ιστορικό). Διαγράψτε μόνο σκόπιμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache with lasting content (e.g. offline music or history). Delete only deliberately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché con contenido duradero (p. ej., música sin conexión o historial). Elimínalo solo de forma deliberada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache au contenu durable (p. ex. musique hors ligne ou historique). À supprimer uniquement en connaissance de cause."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predmemorija s trajnim sadržajem (npr. glazba izvan mreže ili povijest). Brišite samo namjerno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartós tartalmú gyorsítótár (pl. offline zene vagy előzmények). Csak tudatosan törölje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache con contenuti duraturi (ad es. musica offline o cronologia). Eliminala solo consapevolmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache com conteúdo duradouro (p. ex., música offline ou histórico). Elimine apenas de forma intencional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache cu conținut de durată (de ex. muzică offline sau istoric). Ștergeți doar în mod deliberat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnávacia pamäť s trvalým obsahom (napr. offline hudba alebo história). Mažte len cielene."
          }
        }
      }
    },
    "Cache, Log oder Fensterzustand der App.": {
      "localizations": {
