    "Backups von iPhone und iPad. Im Finder beim Gerät unter „Backups verwalten“ aufräumen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zálohy iPhonu a iPadu. Ukliďte je ve Finderu u zařízení v „Spravovat zálohy“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups von iPhone und iPad. Im Finder beim Gerät unter „Backups verwalten“ aufräumen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντίγραφα ασφαλείας iPhone και iPad. Καθαρίστε τα στο Finder στη συσκευή, «Διαχείριση αντιγράφων ασφαλείας»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups of iPhone and iPad. Clean them up in the Finder under the device, “Manage Backups”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de seguridad del iPhone y el iPad. Limpia las copias de seguridad en el Finder, en la sección del dispositivo, en «Gestionar copias de seguridad»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardes de l’iPhone et de l’iPad. Nettoyez-les dans le Finder, sous l’appareil, dans « Gérer les sauvegardes »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosne kopije iPhonea i iPada. Očistite ih u Finderu kod uređaja, „Upravljaj sigurnosnim kopijama”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone- és iPad-biztonsági mentések. A Finderben az eszköznél, a „Biztonsági mentések kezelése” alatt tisztíthatók."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup di iPhone e iPad. Puliscili nel Finder, nella sezione dedicata al dispositivo, sotto “Gestisci backup”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias de segurança do iPhone e do iPad. Limpe-as no Finder, na secção do dispositivo, em «Gerir cópias de segurança»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copii de rezervă ale iPhone și iPad. Curățați-le în Finder la dispozitiv, „Gestionați copiile de rezervă”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zálohy iPhonu a iPadu. Upracte ich vo Finderi pri zariadení v „Spravovať zálohy“."
          }
        }
      }
    },
    "Bald austauschen": {
      "localizations": {
