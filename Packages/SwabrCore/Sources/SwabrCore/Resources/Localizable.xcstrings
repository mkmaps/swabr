    "App-Daten ohne bekannte Funktion. Vor dem Löschen prüfen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data aplikace bez známé funkce. Před smazáním zkontrolujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Daten ohne bekannte Funktion. Vor dem Löschen prüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεδομένα εφαρμογής χωρίς γνωστό σκοπό. Ελέγξτε πριν από τη διαγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App data without a known purpose. Check before deleting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de la app sin una finalidad conocida. Compruébalos antes de borrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de l'application dont la finalité n'est pas connue. Vérifiez avant de les supprimer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci aplikacije bez poznate svrhe. Provjerite prije brisanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismeretlen célú app-adatok. Törlés előtt ellenőrizze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati dell’app senza uno scopo noto. Controlla prima di eliminarli."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados da aplicação sem finalidade conhecida. Verifique antes de eliminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Date de aplicație fără rol cunoscut. Verificați înainte de ștergere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje aplikácie bez známej funkcie. Pred zmazaním skontrolujte."
          }
        }
      }
    },
    "App-Daten: Die zugehörige App kann Einstellungen, Konten oder Inhalte verlieren.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data aplikace: aplikace může přijít o nastavení, účty nebo obsah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Daten: Die zugehörige App kann Einstellungen, Konten oder Inhalte verlieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεδομένα εφαρμογής: η εφαρμογή μπορεί να χάσει ρυθμίσεις, λογαριασμούς ή περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App data: the app may lose settings, accounts or content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de la app: es posible que la app pierda la configuración, las cuentas o el contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de l'application : l'application risque de perdre ses réglages, ses comptes ou son contenu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci aplikacije: aplikacija može izgubiti postavke, račune ili sadržaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "App-adatok: az app elveszítheti a beállításait, fiókjait vagy tartalmát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati dell’app: l’app potrebbe perdere impostazioni, account o contenuti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados da aplicação: a aplicação poderá perder definições, contas ou conteúdos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Date de aplicație: aplicația poate pierde setări, conturi sau conținut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje aplikácie: aplikácia môže prísť o nastavenia, účty alebo obsah."
          }
        }
      }
    },
    "App-Gruppen-Daten: können von anderen Apps desselben Herstellers mitgenutzt werden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data skupiny aplikací: mohou je sdílet další aplikace stejného vývojáře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Gruppen-Daten: können von anderen Apps desselben Herstellers mitgenutzt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεδομένα ομάδας εφαρμογών: μπορεί να χρησιμοποιούνται και από άλλες εφαρμογές του ίδιου προγραμματιστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App group data: may be shared with other apps from the same developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos del grupo de aplicaciones: pueden compartirse con otras aplicaciones del mismo desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données du groupe d’applications : peuvent être partagées avec d’autres applications du même développeur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci grupe aplikacija: mogu ih koristiti i druge aplikacije istog razvojnog programera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Appcsoport-adatok: ugyanazon fejlesztő más appjai is használhatják."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati del gruppo di app: potrebbero essere condivisi con altre app dello stesso sviluppatore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados do grupo de aplicações: podem ser partilhados com outras aplicações do mesmo programador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Date ale grupului de aplicații: pot fi folosite și de alte aplicații ale aceluiași dezvoltator."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje skupiny aplikácií: môžu ich zdieľať ďalšie aplikácie rovnakého vývojára."
          }
        }
      }
    },
