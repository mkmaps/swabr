    "Rotiert alte Systemprotokolle und räumt temporäre Systemdateien auf.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotuje staré systémové logy a uklízí dočasné systémové soubory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotiert alte Systemprotokolle und räumt temporäre Systemdateien auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλάσσει παλιά αρχεία καταγραφής συστήματος και καθαρίζει προσωρινά αρχεία συστήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotates old system logs and cleans up temporary system files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota los registros antiguos del sistema y limpia los archivos temporales del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les anciens journaux système et nettoie les fichiers système temporaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotira stare zapise sustava i čisti privremene sistemske datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotálja a régi rendszernaplókat, és rendezi az ideiglenes rendszerfájlokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rrotola i vecchi log di sistema e pulisce i file temporanei di sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota os registos antigos do sistema e limpa os ficheiros temporários do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotește jurnalele vechi de sistem și curăță fișierele temporare de sistem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotuje staré systémové logy a upratuje dočasné systémové súbory."
          }
        }
      }
    },
