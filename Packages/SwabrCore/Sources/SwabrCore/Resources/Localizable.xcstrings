    "Synchronisierter Ordner: Der Inhalt verschwindet auch auf deinen anderen Geräten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizovaná složka: obsah zmizí i na vašich dalších zařízeních."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierter Ordner: Der Inhalt verschwindet auch auf deinen anderen Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγχρονισμένος φάκελος: το περιεχόμενο εξαφανίζεται και από τις άλλες συσκευές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced folder: the content also disappears on your other devices."
          }
        },
        "es": {
