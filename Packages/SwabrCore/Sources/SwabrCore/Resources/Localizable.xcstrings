    "Mediathek: Fotos oder Musik darin gehen verloren, sofern sie nicht in iCloud oder einem Backup liegen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna médií: fotky nebo hudba v ní se ztratí, pokud nejsou na iCloudu nebo v záloze."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediathek: Fotos oder Musik darin gehen verloren, sofern sie nicht in iCloud oder einem Backup liegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βιβλιοθήκη πολυμέσων: φωτογραφίες ή μουσική σε αυτή χάνονται αν δεν βρίσκονται στο iCloud ή σε αντίγραφο ασφαλείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media library: photos or music in it are lost unless they are in iCloud or a backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca multimedia: las fotos o la música que contenga se perderán a menos que estén en iCloud o en una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèque multimédia : les photos ou la musique qu’elle contient seront perdues à moins qu’elles ne se trouvent dans iCloud ou dans une sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medijska knjižnica: fotografije ili glazba u njoj gube se ako nisu u iCloudu ili sigurnosnoj kopiji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Médiatár: a benne lévő fotók vagy zenék elvesznek, ha nincsenek az iCloudban vagy biztonsági mentésben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreria multimediale: le foto o la musica che contiene andranno perse a meno che non siano su iCloud o in un backup."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca multimédia: as fotografias ou a música que nela se encontram perdem-se, a menos que estejam no iCloud ou numa cópia de segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotecă media: fotografiile sau muzica din ea se pierd dacă nu sunt în iCloud sau într-o copie de rezervă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Knižnica médií: fotky alebo hudba v nej sa stratia, ak nie sú na iCloude alebo v zálohe."
          }
        }
      }
    },
