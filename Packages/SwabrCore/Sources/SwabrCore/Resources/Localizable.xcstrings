            "value": "χρησιμοποιεί εξαιρέσεις του Hardened Runtime που θα χάνονταν με νέα υπογραφή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "uses Hardened Runtime exceptions that re-signing would lose"
          }
