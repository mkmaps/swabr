    "Seit über 60 Tagen nicht benutzt. Entfernen in Xcode → Einstellungen → Komponenten oder mit xcrun simctl runtime delete %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepoužívá se déle než 60 dní. Odstraňte jej v Xcode → Nastavení → Komponenty nebo pomocí příkazu xcrun simctl runtime delete %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit über 60 Tagen nicht benutzt. Entfernen in Xcode → Einstellungen → Komponenten oder mit xcrun simctl runtime delete %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει χρησιμοποιηθεί για πάνω από 60 ημέρες. Αφαιρέστε το στο Xcode → Ρυθμίσεις → Συστατικά ή με την εντολή xcrun simctl runtime delete %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not used for over 60 days. Remove it in Xcode → Settings → Components or with xcrun simctl runtime delete %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha usado en más de 60 días. Elimínalo en Xcode → Ajustes → Componentes o con xcrun simctl runtime delete %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non utilisé depuis plus de 60 jours. Supprimez-le dans Xcode → Paramètres → Composants ou à l'aide de la commande xcrun simctl runtime delete %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije korišten više od 60 dana. Uklonite ga u Xcodeu → Postavke → Komponente ili pomoću naredbe xcrun simctl runtime delete %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Több mint 60 napja nem használt. Távolítsa el az Xcode → Beállítások → Komponensek menüpontban, vagy az xcrun simctl runtime delete %@ paranccsal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non utilizzato da oltre 60 giorni. Rimuovilo in Xcode → Impostazioni → Componenti oppure con xcrun simctl runtime delete %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não utilizado há mais de 60 dias. Elimine-o no Xcode → Definições → Componentes ou com o comando «xcrun simctl runtime delete %@»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost utilizat de peste 60 de zile. Eliminați-l din Xcode → Setări → Componente sau cu comanda xcrun simctl runtime delete %@."
          }
        },
        "sk": {
