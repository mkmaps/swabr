    "Beschädigte Einstellungsdateien von Drittanbieter-Apps finden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najít poškozené soubory nastavení aplikací třetích stran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschädigte Einstellungsdateien von Drittanbieter-Apps finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εύρεση κατεστραμμένων αρχείων προτιμήσεων εφαρμογών τρίτων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find damaged preference files of third-party apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca archivos de preferencias dañados de aplicaciones de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez les fichiers de préférences endommagés des applications tierces."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronađi oštećene datoteke postavki aplikacija trećih strana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmadik féltől származó appok sérült beállításfájljainak keresése."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua i file delle preferenze danneggiati delle app di terze parti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Detete ficheiros de preferências danificados de aplicações de terceiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsiți fișierele de preferințe deteriorate ale aplicațiilor terțe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájsť poškodené súbory nastavení aplikácií tretích strán."
          }
        }
      }
    },
    "Beschädigte Listen für Seitenleiste und „Zuletzt benutzt“ finden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najít poškozené seznamy postranního panelu a „Nedávných položek“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschädigte Listen für Seitenleiste und „Zuletzt benutzt“ finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εύρεση κατεστραμμένων λιστών για την πλαϊνή στήλη και τα «Πρόσφατα στοιχεία»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find damaged lists for the sidebar and “Recent Items”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca las listas dañadas de la barra lateral y de «Elementos recientes»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez les listes endommagées dans la barre latérale et dans la section « Éléments récents »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronađi oštećene popise za bočnu traku i „Nedavne stavke”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az oldalsáv és a „Legutóbbi elemek” sérült listáinak keresése."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova gli elenchi danneggiati relativi alla barra laterale e alla sezione “Elementi recenti”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique as listas com erros na barra lateral e na secção «Itens recentes»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsiți listele deteriorate pentru bara laterală și „Elemente recente”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájsť poškodené zoznamy bočného panela a „Nedávnych položiek“."
          }
        }
      }
    },
    "Betroffene Apps starten mit Standardeinstellungen statt abzustürzen. Die Dateien landen im Papierkorb. Apple-Einstellungen bleiben unberührt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotčené aplikace se spustí s výchozím nastavením místo pádu. Soubory se přesunou do Koše. Nastavení Apple zůstanou nedotčena."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betroffene Apps starten mit Standardeinstellungen statt abzustürzen. Die Dateien landen im Papierkorb. Apple-Einstellungen bleiben unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επηρεαζόμενες εφαρμογές ξεκινούν με προεπιλεγμένες ρυθμίσεις αντί να κολλάνε. Τα αρχεία μεταφέρονται στον Κάδο. Οι ρυθμίσεις της Apple παραμένουν ανέγγιχτες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Affected apps start with default settings instead of crashing. The files go to the Trash. Apple settings stay untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps afectadas se inician con la configuración predeterminada en lugar de bloquearse. Los archivos van a la Papelera. La configuración de Apple no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications concernées démarrent avec leurs paramètres par défaut au lieu de planter. Les fichiers sont envoyés dans la Corbeille. Les réglages Apple restent inchangés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogođene aplikacije pokreću se sa zadanim postavkama umjesto da se ruše. Datoteke idu u Smeće. Appleove postavke ostaju netaknute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az érintett appok összeomlás helyett alapbeállításokkal indulnak. A fájlok a Kukába kerülnek. Az Apple-beállítások érintetlenek maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app interessate si avviano con le impostazioni predefinite invece di bloccarsi. I file finiscono nel Cestino. Le impostazioni di Apple rimangono invariate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações afetadas iniciam com as definições predefinidas, em vez de entrarem em falha. Os ficheiros são enviados para o Lixo. As definições da Apple permanecem inalteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile afectate pornesc cu setări implicite în loc să se blocheze. Fișierele ajung în Coș. Setările Apple rămân neatinse."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknuté aplikácie sa spustia s predvolenými nastaveniami namiesto pádu. Súbory sa presunú do Koša. Nastavenia Apple zostanú nedotknuté."
          }
        }
      }
    },
