    "Behebt falsche oder fehlende Vorschaubilder und Symbole. Der Finder zeigt sie kurz verzögert neu an.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opraví chybné nebo chybějící náhledy a ikony. Finder je s krátkým zpožděním vykreslí znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebt falsche oder fehlende Vorschaubilder und Symbole. Der Finder zeigt sie kurz verzögert neu an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώνει λανθασμένες ή ελλιπείς προεπισκοπήσεις και εικονίδια. Το Finder τα σχεδιάζει ξανά μετά από λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes wrong or missing previews and icons. The Finder redraws them after a short delay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige las vistas previas e iconos erróneos o que faltan. El Finder los vuelve a dibujar tras un breve retraso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les aperçus et les icônes erronés ou manquants. Le Finder les actualise après un court délai."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravlja pogrešne ili nedostajuće pretpreglede i ikone. Finder ih ponovno iscrtava nakon kratke odgode."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijavítja a hibás vagy hiányzó előnézeteket és ikonokat. A Finder rövid késéssel újrarajzolja őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge le anteprime e le icone errate o mancanti. Il Finder le ridisegna dopo un breve ritardo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige pré-visualizações e ícones errados ou em falta. O Finder volta a apresentá-los após um breve atraso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Repară previzualizările și pictogramele greșite sau lipsă. Finder le redesenează după o scurtă întârziere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opraví chybné alebo chýbajúce náhľady a ikony. Finder ich s krátkym oneskorením vykreslí znova."
          }
        }
      }
    },
    "Behebt „Keine Berechtigung“-Fehler in deinem Benutzerordner. Dauert je nach Datenmenge einige Minuten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opraví chyby „Nemáte oprávnění“ ve vaší domovské složce. Trvá několik minut podle množství dat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebt „Keine Berechtigung“-Fehler in deinem Benutzerordner. Dauert je nach Datenmenge einige Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώνει σφάλματα «Δεν έχετε άδεια» στον προσωπικό σας φάκελο. Διαρκεί μερικά λεπτά ανάλογα με τον όγκο δεδομένων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes “No permission” errors in your home folder. Takes a few minutes depending on the amount of data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soluciona los errores de «Sin permiso» en tu carpeta de inicio. Tarda unos minutos, dependiendo de la cantidad de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les erreurs « Aucune autorisation » dans votre dossier personnel. L'opération prend quelques minutes, en fonction du volume de données."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravlja pogreške „Nemate dozvolu” u vašoj kućnoj mapi. Traje nekoliko minuta, ovisno o količini podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijavítja a „Nincs jogosultság” hibákat a saját mappájában. Az adatmennyiségtől függően néhány percig tart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolve gli errori di “Autorizzazione negata” nella tua cartella Home. Ci vogliono pochi minuti, a seconda della quantità di dati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige erros do tipo «Sem permissão» na sua pasta pessoal. Demora alguns minutos, dependendo da quantidade de dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Repară erorile „Fără permisiune” din dosarul de pornire. Durează câteva minute, în funcție de cantitatea de date."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opraví chyby „Nemáte oprávnenie“ vo vašom domovskom priečinku. Trvá niekoľko minút podľa množstva údajov."
          }
        }
      }
    },
