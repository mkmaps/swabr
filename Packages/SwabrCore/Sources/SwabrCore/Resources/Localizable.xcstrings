    "Terragrunt lädt den Inhalt beim nächsten Lauf neu.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt obsah při dalším spuštění znovu stáhne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt lädt den Inhalt beim nächsten Lauf neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Terragrunt κατεβάζει ξανά το περιεχόμενο στην επόμενη εκτέλεση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt downloads the content again on the next run."
          }
        },
        "es": {
