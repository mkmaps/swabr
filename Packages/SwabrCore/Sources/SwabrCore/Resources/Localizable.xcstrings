          "stringUnit": {
            "state": "translated",
            "value": "Requer atenção"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesită atenție"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje pozornosť"
          }
        }
      }
    },
    "Browser- oder Spielprofil: Passwörter, Verlauf, Spielstände. Nur gezielt löschen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil prohlížeče nebo hry: hesla, historie, uložené hry. Mažte jen záměrně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser- oder Spielprofil: Passwörter, Verlauf, Spielstände. Nur gezielt löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προφίλ προγράμματος περιήγησης ή παιχνιδιού: συνθηματικά, ιστορικό, αποθηκευμένα παιχνίδια. Διαγράψτε μόνο συνειδητά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser or game profile: passwords, history, saved games. Delete only deliberately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil del navegador o del juego: contraseñas, historial, partidas guardadas. Bórralas solo si lo haces a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil de navigateur ou de jeu : mots de passe, historique, parties sauvegardées. Ne les supprimez que de manière délibérée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil preglednika ili igre: lozinke, povijest, spremljene igre. Brišite samo namjerno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Böngésző- vagy játékprofil: jelszavak, előzmények, mentések. Csak szándékosan törölje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo del browser o del gioco: password, cronologia, partite salvate. Cancella solo se lo vuoi davvero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil do navegador ou do jogo: palavras-passe, histórico, jogos guardados. Apague apenas de forma deliberada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil de browser sau de joc: parole, istoric, salvări. Ștergeți doar intenționat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil prehliadača alebo hry: heslá, história, uložené hry. Mažte len zámerne."
          }
        }
      }
    },
    "Browser-Cache. Seiten laden beim ersten Besuch etwas langsamer. Anmeldungen, Verlauf und Lesezeichen bleiben.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezipaměť prohlížeče. Stránky se při první návštěvě načtou o něco pomaleji. Přihlášení, historie a záložky zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser-Cache. Seiten laden beim ersten Besuch etwas langsamer. Anmeldungen, Verlauf und Lesezeichen bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache προγράμματος περιήγησης. Οι σελίδες φορτώνουν λίγο πιο αργά στην πρώτη επίσκεψη. Συνδέσεις, ιστορικό και σελιδοδείκτες παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser cache. Pages load a bit slower on the first visit. Logins, history and bookmarks stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché del navegador. Las páginas se cargan un poco más lentas la primera vez que las visitas. Los datos de inicio de sesión, el historial y los marcadores se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache du navigateur. Les pages se chargent un peu plus lentement lors de la première visite. Les identifiants de connexion, l'historique et les signets sont conservés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predmemorija preglednika. Stranice se pri prvom posjetu učitavaju malo sporije. Prijave, povijest i oznake ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Böngésző-gyorsítótár. Az oldalak első látogatáskor kicsit lassabban töltődnek be. A bejelentkezések, előzmények és könyvjelzők megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache del browser. Le pagine si caricano un po’ più lentamente alla prima visita. I dati di accesso, la cronologia e i segnalibri rimangono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache do navegador. As páginas carregam um pouco mais lentamente na primeira visita. Os dados de início de sessão, o histórico e os favoritos permanecem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de browser. Paginile se încarcă puțin mai încet la prima vizită. Autentificările, istoricul și marcajele rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnávacia pamäť prehliadača. Stránky sa pri prvej návšteve načítajú o niečo pomalšie. Prihlásenia, história a záložky zostanú."
          }
        }
      }
    },
    "Build-Ergebnisse. Werden beim nächsten Build neu erzeugt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky sestavení. Vytvoří se znovu při příštím sestavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Ergebnisse. Werden beim nächsten Build neu erzeugt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
