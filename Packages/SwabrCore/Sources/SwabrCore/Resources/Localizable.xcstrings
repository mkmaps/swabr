    "Abhängigkeiten oder Build-Ergebnisse. Werden bei Bedarf neu erzeugt (z. B. durch npm install oder einen Build).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Závislosti nebo výsledky sestavení. V případě potřeby se vytvoří znovu (např. npm install nebo sestavením)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängigkeiten oder Build-Ergebnisse. Werden bei Bedarf neu erzeugt (z. B. durch npm install oder einen Build)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαρτήσεις ή αποτελέσματα build. Δημιουργούνται ξανά όταν χρειάζεται (π.χ. με npm install ή ένα build)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencies or build output. Recreated when needed (e.g. by npm install or a build)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencias o resultados de la compilación. Se recrean cuando hace falta (por ejemplo, con «npm install» o al compilar)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépendances ou résultats de compilation. Recréés si nécessaire (par exemple, par la commande « npm install » ou lors d'une compilation)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovisnosti ili rezultati builda. Ponovno se stvaraju po potrebi (npr. s npm install ili buildom)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Függőségek vagy build-eredmények. Szükség esetén újra létrejönnek (pl. npm install vagy build által)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipendenze o output di compilazione. Vengono ricreati quando necessario (ad esempio tramite `npm install` o una compilazione)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependências ou resultados da compilação. Recriados quando necessário (por exemplo, através do comando «npm install» ou de uma compilação)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependențe sau rezultate de build. Se recreează la nevoie (de ex. prin npm install sau un build)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Závislosti alebo výsledky zostavenia. V prípade potreby sa vytvoria znova (napr. npm install alebo zostavením)."
          }
        }
      }
    },
