            "state": "translated",
            "value": "Postavka se nije mogla promijeniti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítás nem módosítható"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile modificare l'impostazione"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar a configuração"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setarea nu a putut fi modificată"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenie sa nedá zmeniť"
          }
        }
      }
    },
    "Einstellungen der App. Bei Neuinstallation startet sie wie neu.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení aplikace. Po přeinstalaci se spustí jako nová."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen der App. Bei Neuinstallation startet sie wie neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις της εφαρμογής. Μετά από επανεγκατάσταση ξεκινά σαν καινούργια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's settings. After a reinstall it starts like new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de la app. Tras reinstalarla, vuelve a funcionar como si fuera nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de l'application. Après une réinstallation, elle redémarre comme si elle était neuve."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavke aplikacije. Nakon ponovne instalacije pokreće se kao nova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app beállításai. Újratelepítés után újként indul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni dell’app. Dopo una reinstallazione, parte come se fosse nuova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições da aplicação. Após uma reinstalação, a aplicação inicia como se fosse nova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările aplicației. După reinstalare pornește ca nouă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenia aplikácie. Po preinštalovaní sa spustí ako nová."
          }
        }
      }
    },
    "Entfernt nur das Programm. Einstellungen und Reste bleiben, dafür „Deinstallieren“ verwenden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní jen program. Nastavení a zbytky zůstanou; k tomu použijte „Odinstalovat“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt nur das Programm. Einstellungen und Reste bleiben, dafür „Deinstallieren“ verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί μόνο το πρόγραμμα. Ρυθμίσεις και υπολείμματα παραμένουν· για αυτά χρησιμοποιήστε την «Απεγκατάσταση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes only the program. Settings and leftovers stay; use “Uninstall” for those."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo elimina el programa. La configuración y los archivos residuales se quedan; usa «Desinstalar» para eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne supprime que le programme. Les réglages et les fichiers résiduels sont conservés ; utilisez « Désinstaller » pour ceux-ci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja samo program. Postavke i ostaci ostaju; za njih koristite „Deinstaliraj”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a programot távolítja el. A beállítások és maradványok megmaradnak; ehhez használja az „Eltávolítás” funkciót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove solo il programma. Le impostazioni e i file residui rimangono; per quelli usa “Disinstalla”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove apenas o programa. As definições e os ficheiros residuais permanecem; utilize «Desinstalar» para esses casos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină doar programul. Setările și resturile rămân; pentru acestea folosiți „Dezinstalați”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni len program. Nastavenia a zvyšky zostanú; na to použite „Odinštalovať“."
          }
        }
      }
    },
