    "nutzt Ausnahmen der Hardened Runtime, die beim Neusignieren verloren gingen": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "používá výjimky Hardened Runtime, které by se při novém podpisu ztratily"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nutzt Ausnahmen der Hardened Runtime, die beim Neusignieren verloren gingen"
          }
        },
        "el": {
          "stringUnit": {
