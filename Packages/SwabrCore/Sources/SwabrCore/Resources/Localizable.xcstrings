    "Entwicklerdaten (Xcode, Simulatoren). Werden teilweise neu erstellt, Simulator-Inhalte gehen verloren.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vývojářská data (Xcode, simulátory). Částečně se obnoví, obsah simulátorů se ztratí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklerdaten (Xcode, Simulatoren). Werden teilweise neu erstellt, Simulator-Inhalte gehen verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεδομένα προγραμματιστή (Xcode, προσομοιωτές). Αναδημιουργούνται εν μέρει· το περιεχόμενο των προσομοιωτών χάνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer data (Xcode, simulators). Partly recreated; simulator contents are lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de desarrollo (Xcode, simuladores). Se recrean en parte; el contenido de los simuladores se pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de développement (Xcode, simulateurs). Recréées en partie ; le contenu des simulateurs est perdu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci za razvoj (Xcode, simulatori). Djelomično se ponovno stvaraju, sadržaj simulatora se gubi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejlesztői adatok (Xcode, szimulátorok). Részben újra létrejönnek, a szimulátorok tartalma elvész."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati di sviluppo (Xcode, simulatori). Ricreati in parte; i contenuti dei simulatori vanno persi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de programação (Xcode, simuladores). Recriados em parte; o conteúdo dos simuladores perde-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Date pentru dezvoltatori (Xcode, simulatoare). Parțial recreate, conținutul simulatoarelor se pierde."
          }
        },
        "sk": {
