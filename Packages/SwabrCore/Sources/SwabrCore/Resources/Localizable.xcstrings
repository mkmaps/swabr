    "Ausschlüsse in den Spotlight-Einstellungen finden, deren Ort nicht mehr existiert (nur Bericht).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najde v nastavení Spotlightu výjimky, jejichž umístění již neexistuje (pouze hlášení)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschlüsse in den Spotlight-Einstellungen finden, deren Ort nicht mehr existiert (nur Bericht)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντοπίστε στις ρυθμίσεις του Spotlight τις εξαιρέσεις των οποίων η θέση δεν υπάρχει πλέον (μόνο αναφορά)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find exclusions in the Spotlight settings whose place no longer exists (report only)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en los ajustes de Spotlight las exclusiones cuya ubicación ya no existe (solo para informar)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez dans les réglages de Spotlight les exclusions dont l'emplacement n'existe plus (à des fins d'information uniquement)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronalazi isključenja u postavkama Spotlighta čija lokacija više ne postoji (samo izvješće)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresse meg a Spotlight beállításaiban azokat a kizárásokat, amelyek helye már nem létezik (csak jelentés)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua nelle impostazioni di Spotlight le esclusioni il cui percorso non esiste più (solo segnalazione)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique exclusões nas definições do Spotlight cuja localização já não existe (apenas para informação)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificați excluderile din setările Spotlight a căror locație nu mai există (doar raportare)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájde v nastaveniach Spotlightu výnimky, ktorých umiestnenie už neexistuje (len hlásenie)."
          }
        }
      }
    },
