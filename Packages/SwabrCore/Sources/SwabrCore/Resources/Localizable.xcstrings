    "Wird bei Bedarf neu erstellt. Betroffene Apps starten beim nächsten Mal eventuell etwas langsamer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V případě potřeby se vytvoří znovu. Dotčené aplikace se příště mohou spustit o něco pomaleji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei Bedarf neu erstellt. Betroffene Apps starten beim nächsten Mal eventuell etwas langsamer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργούνται ξανά όταν χρειάζεται. Οι επηρεαζόμενες εφαρμογές μπορεί να ξεκινήσουν λίγο πιο αργά την επόμενη φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreated when needed. Affected apps may start a little slower next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recrea cuando hace falta. Las apps afectadas pueden tardar un poco más en abrirse la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recréé si nécessaire. Les applications concernées peuvent démarrer un peu plus lentement la prochaine fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno se stvara po potrebi. Pogođene aplikacije sljedeći se put mogu pokrenuti malo sporije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szükség esetén újra létrejön. Az érintett appok legközelebb kicsit lassabban indulhatnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene ricreato quando necessario. Le app interessate potrebbero avviarsi un po’ più lentamente la volta successiva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
