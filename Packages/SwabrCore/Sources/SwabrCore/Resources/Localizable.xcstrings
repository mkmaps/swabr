    "Datenschutz: macOS vergisst, welche Dateien woher geladen wurden. Bereits geprüfte Apps bleiben freigegeben.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromí: macOS zapomene, které soubory byly odkud staženy. Již ověřené aplikace zůstanou povoleny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz: macOS vergisst, welche Dateien woher geladen wurden. Bereits geprüfte Apps bleiben freigegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόρρητο: το macOS ξεχνά ποια αρχεία λήφθηκαν από πού. Οι εφαρμογές που έχουν ήδη ελεγχθεί παραμένουν εγκεκριμένες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy: macOS forgets which files were downloaded from where. Apps already checked stay approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidad: macOS olvida qué archivos se descargaron y de dónde. Las apps que ya has marcado siguen estando aprobadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité : macOS oublie quels fichiers ont été téléchargés et d’où ils proviennent. Les applications déjà cochées restent approuvées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatnost: macOS zaboravlja koje su datoteke odakle preuzete. Već provjerene aplikacije ostaju odobrene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adatvédelem: a macOS elfelejti, melyik fájl honnan lett letöltve. A már ellenőrzött appok engedélyezve maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy: macOS non ricorda quali file sono stati scaricati e da dove. Le app già selezionate rimangono approvate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade: o macOS não guarda registos de quais os ficheiros que foram descarregados nem de onde. As aplicações já verificadas permanecem aprovadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidențialitate: macOS uită ce fișiere au fost descărcate de unde. Aplicațiile deja verificate rămân aprobate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súkromie: macOS zabudne, ktoré súbory boli odkiaľ stiahnuté. Už overené aplikácie zostanú povolené."
          }
        }
      }
    },
