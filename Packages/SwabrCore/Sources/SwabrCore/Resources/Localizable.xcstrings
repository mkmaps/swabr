            "state": "translated",
            "value": "Terragrunt vuelve a descargar el contenido en la próxima ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt retélécharge le contenu à la prochaine exécution."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt ponovno preuzima sadržaj pri sljedećem pokretanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Terragrunt a következő futáskor újra letölti a tartalmat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt scarica di nuovo il contenuto alla prossima esecuzione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Terragrunt volta a descarregar o conteúdo na próxima execução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt descarcă din nou conținutul la următoarea rulare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Terragrunt obsah pri ďalšom spustení znova stiahne."
          }
        }
      }
    },
    "Testumgebungen von tox bzw. nox: werden beim nächsten Lauf neu angelegt.": {
