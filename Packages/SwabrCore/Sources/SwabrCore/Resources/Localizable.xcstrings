    "Prüfsumme stimmt nicht, Download verworfen": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolní součet nesouhlasí, stažení zahozeno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfsumme stimmt nicht, Download verworfen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άθροισμα ελέγχου δεν ταιριάζει, η λήψη απορρίφθηκε"
