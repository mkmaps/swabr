        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Finder já não cria ficheiros .DS_Store nesse local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder nu mai creează fișiere .DS_Store acolo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder tam už nevytvára súbory .DS_Store."
          }
        }
      }
    },
