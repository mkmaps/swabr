    "Apps öffnen beim nächsten Start ihre zuletzt offenen Fenster nicht wieder.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace při příštím spuštění neotevřou naposledy otevřená okna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps öffnen beim nächsten Start ihre zuletzt offenen Fenster nicht wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές δεν θα ανοίγουν ξανά τα τελευταία παράθυρά τους στην επόμενη εκκίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps won't reopen their last windows at the next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps no volverán a abrir sus últimas ventanas la próxima vez que las abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications ne rouvriront pas leurs dernières fenêtres lors du prochain lancement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije pri sljedećem pokretanju neće ponovno otvarati zadnje prozore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appok a következő indításkor nem nyitják meg újra az utolsó ablakaikat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app non riapriranno le ultime finestre al prossimo avvio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações não reabrirão as suas últimas janelas na próxima vez que forem iniciadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile nu își redeschid ultimele ferestre la următoarea pornire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie pri ďalšom spustení neotvoria naposledy otvorené okná."
          }
        }
      }
    },
    "Apps, die du über einen Monat nicht benutzt hast, öffnen ihre alten Fenster beim nächsten Start nicht wieder.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace, které jste více než měsíc nepoužili, při příštím spuštění neotevřou stará okna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die du über einen Monat nicht benutzt hast, öffnen ihre alten Fenster beim nächsten Start nicht wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που δεν έχετε χρησιμοποιήσει για πάνω από έναν μήνα δεν θα ανοίγουν ξανά τα παλιά παράθυρά τους στην επόμενη εκκίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps you haven't used for over a month won't reopen their old windows at the next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que no hayas usado en más de un mes no volverán a abrir sus ventanas anteriores la próxima vez que las abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications que vous n’avez pas utilisées depuis plus d’un mois ne rouvriront pas leurs anciennes fenêtres lors du prochain lancement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije koje niste koristili više od mjesec dana pri sljedećem pokretanju neće ponovno otvarati stare prozore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egy hónapnál régebben használt appok a következő indításkor nem nyitják meg újra a régi ablakaikat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che non usi da più di un mese non riapriranno le vecchie finestre al prossimo avvio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que não tenha utilizado há mais de um mês não voltarão a abrir as suas janelas anteriores na próxima vez que forem iniciadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile nefolosite de peste o lună nu își redeschid ferestrele vechi la următoarea pornire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie, ktoré ste viac než mesiac nepoužili, pri ďalšom spustení neotvoria staré okná."
          }
        }
      }
    },
    "Arbeitskopien, die KI-Agenten für einzelne Aufgaben angelegt haben. Nicht übernommene Änderungen darin gehen verloren.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracovní kopie, které agenti AI vytvořili pro jednotlivé úkoly. Změny v nich, které nebyly sloučeny, se ztratí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitskopien, die KI-Agenten für einzelne Aufgaben angelegt haben. Nicht übernommene Änderungen darin gehen verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντίγραφα εργασίας που δημιούργησαν οι πράκτορες τεχνητής νοημοσύνης για μεμονωμένες εργασίες. Οι αλλαγές σε αυτά που δεν ενσωματώθηκαν χάνονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working copies that AI agents created for single tasks. Changes in them that were not merged are lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de trabajo que los agentes de IA han creado para tareas concretas. Los cambios que no se hayan fusionado se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies de travail créées par des agents IA pour des tâches spécifiques. Les modifications qui n’ont pas été fusionnées sont perdues."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radne kopije koje su AI agenti stvorili za pojedinačne zadatke. Promjene u njima koje nisu spojene su izgubljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI-ügynökök által egyes feladatokhoz létrehozott munkakópiák. Azokban a változtatások, amelyeket nem egyesítettek, elvesznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie di lavoro create dagli agenti IA per singole attività. Le modifiche apportate a queste copie che non sono state integrate vanno perse."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias de trabalho criadas por agentes de IA para tarefas específicas. As alterações nelas introduzidas que não tenham sido integradas são perdidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copii de lucru create de agenții AI pentru sarcini individuale. Modificările din acestea care nu au fost integrate se pierd."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracovné kópie, ktoré vytvorili agenti umelej inteligencie pre jednotlivé úlohy. Zmeny v nich, ktoré neboli zlúčené, sa stratia."
          }
        }
      }
    },
    "Arbeitsumgebung von Claude für Aufgaben am Computer. Wird bei Bedarf neu geladen; in Claude unter Einstellungen verwalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeovo pracovní prostředí pro úkoly na počítači. V případě potřeby se stáhne znovu; spravujte jej v nastaveních aplikace Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsumgebung von Claude für Aufgaben am Computer. Wird bei Bedarf neu geladen; in Claude unter Einstellungen verwalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιβάλλον εργασίας του Claude για εργασίες στον υπολογιστή. Κατεβάζεται ξανά όταν χρειάζεται· διαχειριστείτε το στις ρυθμίσεις του Claude."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude's working environment for tasks on the computer. Downloaded again when needed; manage it in Claude's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno de trabajo de Claude para las tareas en el ordenador. Se vuelve a descargar cuando hace falta; lo gestionas en la configuración de Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement de travail de Claude pour les tâches sur l'ordinateur. À télécharger à nouveau en cas de besoin ; gérez-le dans les réglages de Claude."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radno okruženje Claudea za zadatke na računalu. Ponovno ga preuzmite kad je potrebno; upravljajte njime u postavkama Claudea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude munkakörnyezete a számítógépen végzendő feladatokhoz. Szükség esetén újra letölthető; a kezelése a Claude beállításaiban történik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ambiente di lavoro di Claude per le attività sul computer. Si scarica di nuovo quando serve; gestiscilo nelle impostazioni di Claude."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente de trabalho do Claude para tarefas no computador. É descarregado novamente quando necessário; pode ser gerido nas definições do Claude."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediul de lucru al lui Claude pentru sarcinile de pe computer. Se descarcă din nou atunci când este necesar; se gestionează din setările lui Claude."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeovo pracovné prostredie pre úlohy na počítači. V prípade potreby sa stiahne znova; spravujte ho v nastaveniach aplikácie Claude."
          }
        }
      }
    },
    "Archiv ließ sich nicht entpacken": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiv nelze rozbalit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiv ließ sich nicht entpacken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποσυμπίεση της αρχειοθήκης"
