    "Nicht vorausgewählt: kann noch benötigte Daten, Einstellungen oder Verläufe enthalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepředvybráno: může obsahovat data, nastavení nebo historii, které ještě potřebujete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht vorausgewählt: kann noch benötigte Daten, Einstellungen oder Verläufe enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν προεπιλέγεται: μπορεί να περιέχει ακόμη δεδομένα, ρυθμίσεις ή ιστορικό που χρειάζεστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not preselected: may still contain data, settings or history you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está preseleccionado: puede que aún contenga datos, ajustes o historial que necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non présélectionné : peut encore contenir des données, des paramètres ou un historique dont vous avez besoin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije unaprijed odabrano: možda još sadrži podatke, postavke ili povijest koje trebate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs előre kijelölve: még szükséges adatokat, beállításokat vagy előzményeket tartalmazhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non preselezionato: potrebbe comunque contenere dati, impostazioni o cronologia di cui hai bisogno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pré-selecionado: pode ainda conter dados, definições ou histórico de que necessita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepreselectat: poate conține încă date, setări sau istoric de care aveți nevoie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepredvybrané: môže obsahovať údaje, nastavenia alebo históriu, ktoré ešte potrebujete."
          }
        }
      }
    },
    "Notarisierte App wäre danach nicht mehr gültig signiert, nichts verändert": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Notarizovaná aplikace by pak už nebyla platně podepsaná, nic se nezměnilo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notarisierte App wäre danach nicht mehr gültig signiert, nichts verändert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επικυρωμένη εφαρμογή δεν θα είχε πλέον έγκυρη υπογραφή· δεν άλλαξε τίποτα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notarized app would no longer be validly signed afterwards; nothing was changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app notarizada dejaría de tener una firma válida; no se ha cambiado nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app notariée ne serait plus correctement signée ensuite ; rien n'a été modifié"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovjerena aplikacija nakon toga više ne bi bila valjano potpisana, ništa nije promijenjeno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hitelesített app ezután már nem lenne érvényesen aláírva, semmi sem változott"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app notarizzata non sarebbe più firmata correttamente; nulla è stato modificato"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app notarizada deixaria de ter uma assinatura válida; nada foi alterado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația notarizată nu ar mai fi semnată valid după aceea; nu s-a modificat nimic"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notarizovaná aplikácia by potom už nebola platne podpísaná, nič sa nezmenilo"
          }
        }
      }
    },
