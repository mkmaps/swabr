          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemweite Datei der App (für alle Benutzer). Entfernen braucht dein Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχείο εφαρμογής για όλο το σύστημα (για όλους τους χρήστες). Η αφαίρεση χρειάζεται το συνθηματικό σας."
