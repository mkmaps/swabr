    "Simulatoren mit ihren Apps. In Xcode unter „Devices and Simulators“ verwalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulátory s jejich aplikacemi. Spravujte je v Xcode v „Devices and Simulators“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatoren mit ihren Apps. In Xcode unter „Devices and Simulators“ verwalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσομοιωτές με τις εφαρμογές τους. Διαχειριστείτε τους στο Xcode στο «Devices and Simulators»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulators with their apps. Manage them in Xcode under “Devices and Simulators”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuladores con sus aplicaciones. Gánalos en Xcode en «Dispositivos y simuladores»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les simulateurs et leurs applications. Gérez-les dans Xcode sous « Appareils et simulateurs »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatori s njihovim aplikacijama. Upravljajte njima u Xcodeu pod „Devices and Simulators”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szimulátorok az appjaikkal. Az Xcode „Devices and Simulators” részében kezelhetők."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatori con le relative app. Gestiscili in Xcode nella sezione “Dispositivi e simulatori”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuladores com as respetivas aplicações. Faça a sua gestão no Xcode, na secção «Dispositivos e Simuladores»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatoare cu aplicațiile lor. Gestionați-le în Xcode la „Devices and Simulators”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulátory s ich aplikáciami. Spravujte ich v Xcode v „Devices and Simulators“."
          }
        }
      }
    },
    "Siri-Vorschläge und Spotlight lernen deine Gewohnheiten neu. Kontakte, Nachrichten und Mails bleiben erhalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy Siri a Spotlight se znovu naučí vaše zvyky. Kontakty, zprávy a e-maily zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri-Vorschläge und Spotlight lernen deine Gewohnheiten neu. Kontakte, Nachrichten und Mails bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι Προτάσεις Siri και το Spotlight μαθαίνουν ξανά τις συνήθειές σας. Επαφές, μηνύματα και email παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri Suggestions and Spotlight learn your habits again. Contacts, messages and mail stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias de Siri y Spotlight vuelven a aprender tus hábitos. Los contactos, los mensajes y el correo se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions Siri et Spotlight réapprennent vos habitudes. Vos contacts, vos messages et vos e-mails sont conservés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri prijedlozi i Spotlight ponovno uče vaše navike. Kontakti, poruke i e-pošta ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri-javaslatok és a Spotlight újra megtanulják a szokásait. A kontaktok, üzenetek és e-mailek megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti di Siri e Spotlight imparano di nuovo le tue abitudini. Contatti, messaggi e posta rimangono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As Sugestões da Siri e o Spotlight voltam a aprender os seus hábitos. Os contactos, as mensagens e o e-mail permanecem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestiile Siri și Spotlight vă învață din nou obiceiurile. Contactele, mesajele și e-mailurile rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy Siri a Spotlight sa znova naučia vaše zvyky. Kontakty, správy a e-maily zostanú."
          }
        }
      }
    },
