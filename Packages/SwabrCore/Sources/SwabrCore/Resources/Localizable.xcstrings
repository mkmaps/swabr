    "Der Papierkorb wird endgültig geleert. Diese Dateien lassen sich danach nicht wiederherstellen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koš se trvale vyprázdní. Tyto soubory pak nelze obnovit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Papierkorb wird endgültig geleert. Diese Dateien lassen sich danach nicht wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Κάδος αδειάζει οριστικά. Αυτά τα αρχεία δεν μπορούν να ανακτηθούν μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trash is emptied permanently. These files can't be restored afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Papelera se vacía de forma definitiva. Estos archivos no se pueden recuperar después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Corbeille est vidée définitivement. Ces fichiers ne peuvent plus être restaurés par la suite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smeće se trajno prazni. Te se datoteke poslije ne mogu vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kuka véglegesen kiürül. Ezek a fájlok utána nem állíthatók vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Cestino viene svuotato definitivamente. Questi file non potranno più essere recuperati in seguito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Caixote do Lixo é esvaziado de forma definitiva. Estes ficheiros não podem ser recuperados posteriormente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coșul este golit definitiv. Aceste fișiere nu mai pot fi restaurate după aceea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôš sa natrvalo vyprázdni. Tieto súbory potom nemožno obnoviť."
          }
        }
      }
    },
    "Die Listen „Zuletzt benutzt“ im Apple-Menü und in Apps werden geleert.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznamy „Nedávné položky“ v nabídce Apple a v aplikacích se vymažou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Listen „Zuletzt benutzt“ im Apple-Menü und in Apps werden geleert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λίστες «Πρόσφατα στοιχεία» στο μενού Apple και στις εφαρμογές εκκαθαρίζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “Recent Items” lists in the Apple menu and in apps are cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran las listas de «Elementos recientes» del menú Apple y de las aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes « Éléments récents » du menu Apple et des applications sont effacées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popisi „Nedavne stavke” u Apple izborniku i u aplikacijama se brišu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple menü és az appok „Legutóbbi elemek” listái törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elenchi “Elementi recenti” nel menu Apple e nelle app vengono svuotati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas de «Itens recentes» no menu Apple e nas aplicações são esvaziadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listele „Elemente recente” din meniul Apple și din aplicații sunt golite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznamy „Nedávne položky“ v ponuke Apple a v aplikáciách sa vymažú."
