    "Falls neu aufgebaut wird: Spotlight findet für einige Stunden nicht alles und der Mac arbeitet im Hintergrund mehr.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se index obnoví: Spotlight několik hodin nenajde vše a Mac více pracuje na pozadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls neu aufgebaut wird: Spotlight findet für einige Stunden nicht alles und der Mac arbeitet im Hintergrund mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν γίνει αναδημιουργία: το Spotlight δεν θα βρίσκει τα πάντα για μερικές ώρες και το Mac δουλεύει περισσότερο στο παρασκήνιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it is rebuilt: Spotlight won't find everything for a few hours and the Mac works more in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se vuelve a compilar: Spotlight tardará unas horas en encontrar todo y el Mac trabajará más en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas de reconstruction : Spotlight ne trouvera pas tout pendant quelques heures et le Mac fonctionnera davantage en arrière-plan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se ponovno izgradi: Spotlight nekoliko sati neće pronalaziti sve, a Mac više radi u pozadini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha újraépül: a Spotlight néhány óráig nem talál meg mindent, és a Mac többet dolgozik a háttérben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se viene ricostruito: Spotlight non troverà tutto per qualche ora e il Mac lavorerà di più in background."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso seja reinstalado: o Spotlight não irá encontrar tudo durante algumas horas e o Mac funcionará mais em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă este reconstruit: Spotlight nu găsește totul câteva ore, iar Mac-ul lucrează mai mult în fundal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa index obnoví: Spotlight niekoľko hodín nenájde všetko a Mac viac pracuje na pozadí."
          }
        }
      }
    },
    "Fehler gefunden: im Festplattendienstprogramm „Erste Hilfe“ ausführen": {
