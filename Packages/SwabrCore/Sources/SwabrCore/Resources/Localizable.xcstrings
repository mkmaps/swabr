    "Teil der Benutzer-Library. Apps können Daten oder Einstellungen verlieren.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Součást uživatelské Library. Aplikace mohou přijít o data nebo nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil der Benutzer-Library. Apps können Daten oder Einstellungen verlieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέρος της Library του χρήστη. Οι εφαρμογές μπορεί να χάσουν δεδομένα ή ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the user Library. Apps may lose data or settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de la biblioteca del usuario. Las apps pueden perder datos o ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait partie de la bibliothèque utilisateur. Les applications peuvent perdre des données ou des paramètres."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dio korisničke Library mape. Aplikacije mogu izgubiti podatke ili postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhasználói Library része. Az appok adatokat vagy beállításokat veszíthetnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa parte della Libreria dell’utente. Le app potrebbero perdere dati o impostazioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte da Biblioteca do utilizador. As aplicações podem perder dados ou definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte din Library a utilizatorului. Aplicațiile pot pierde date sau setări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súčasť používateľskej Library. Aplikácie môžu prísť o údaje alebo nastavenia."
          }
        }
      }
    },
