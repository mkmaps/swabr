            "value": "Archív sa nedá rozbaliť"
          }
        }
      }
    },
    "Archivierte App-Builds. In Xcode im Organizer (Window → Organizer) löschen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivované sestavení aplikací. Smažte je v Organizeru v Xcode (Window → Organizer)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte App-Builds. In Xcode im Organizer (Window → Organizer) löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχειοθετημένα builds εφαρμογών. Διαγράψτε τα στον Organizer του Xcode (Window → Organizer)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived app builds. Delete them in Xcode's Organizer (Window → Organizer)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilaciones de apps archivadas. Elimínalas en el Organizer de Xcode (Window → Organizer)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds d'apps archivés. Supprimez-les dans l'Organizer de Xcode (Window → Organizer)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivirane izgradnje aplikacija. Izbrišite ih u Xcodeovom Organizeru (Window → Organizer)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivált app-buildek. Az Xcode Organizerében törölhetők (Window → Organizer)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Build di app archiviate. Eliminale nell'Organizer di Xcode (Window → Organizer)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilações de apps arquivadas. Elimine-as no Organizer do Xcode (Window → Organizer)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-uri de aplicații arhivate. Ștergeți-le în Organizer din Xcode (Window → Organizer)."
          }
        },
        "sk": {
