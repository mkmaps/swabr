    },
    "Hilft, wenn Webseiten nach einer Netzwerk- oder DNS-Änderung nicht erreichbar sind. Erste Seitenaufrufe dauern minimal länger.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomůže, když jsou weby po změně sítě nebo DNS nedostupné. První načtení stránek trvá o chvilku déle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft, wenn Webseiten nach einer Netzwerk- oder DNS-Änderung nicht erreichbar sind. Erste Seitenaufrufe dauern minimal länger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βοηθά όταν ιστότοποι δεν είναι προσβάσιμοι μετά από αλλαγή δικτύου ή DNS. Οι πρώτες φορτώσεις σελίδων διαρκούν λίγο περισσότερο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps when websites are unreachable after a network or DNS change. The first page loads take a moment longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te ayuda cuando no puedes acceder a las páginas web tras un cambio en la red o en el DNS. La primera vez que se cargan las páginas tarda un poco más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile lorsque des sites web sont inaccessibles après un changement de réseau ou de DNS. Le chargement de la première page prend un peu plus de temps."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaže kad web stranice nisu dostupne nakon promjene mreže ili DNS-a. Prva učitavanja stranica traju malo dulje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segít, ha a weboldalak hálózat- vagy DNS-váltás után nem érhetők el. Az első oldalbetöltések kicsit tovább tartanak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È utile quando i siti web non sono raggiungibili dopo una modifica alla rete o al DNS. Il primo caricamento delle pagine richiede un po’ più di tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda quando os sites ficam inacessíveis após uma alteração na rede ou no DNS. O carregamento da primeira página demora um pouco mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajută când site-urile nu sunt accesibile după o schimbare de rețea sau DNS. Primele încărcări de pagini durează puțin mai mult."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomôže, keď sú weby po zmene siete alebo DNS nedostupné. Prvé načítanie stránok trvá o chvíľu dlhšie."
          }
        }
      }
    },
    "Hintergrunddienst, der sonst weiter versucht, die entfernte App zu starten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba na pozadí, která by se jinak dál pokoušela spustit odstraněnou aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrunddienst, der sonst weiter versucht, die entfernte App zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπηρεσία παρασκηνίου που διαφορετικά θα συνέχιζε να προσπαθεί να εκκινήσει την αφαιρεμένη εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background service that would otherwise keep trying to start the removed app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio en segundo plano que, de no ser así, seguiría intentando iniciar la aplicación eliminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service d'arrière-plan qui, sans cela, continuerait à tenter de lancer l'application supprimée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinska usluga koja bi inače i dalje pokušavala pokrenuti uklonjenu aplikaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Háttérszolgáltatás, amely különben továbbra is megpróbálná elindítani az eltávolított appot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servizio in background che, altrimenti, continuerebbe a tentare di avviare l’app rimossa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviço em segundo plano que, de outra forma, continuaria a tentar iniciar a aplicação removida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciu de fundal care altfel ar încerca în continuare să pornească aplicația eliminată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba na pozadí, ktorá by sa inak ďalej pokúšala spustiť odstránenú aplikáciu."
          }
        }
      }
    },
