    "Cache, Log oder temporäre Daten, die bei Bedarf neu erstellt werden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezipaměť, log nebo dočasná data, která se v případě potřeby vytvoří znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, Log oder temporäre Daten, die bei Bedarf neu erstellt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, αρχείο καταγραφής ή προσωρινά δεδομένα που δημιουργούνται ξανά όταν χρειάζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, log or temporary data that is recreated when needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de caché, de registro o temporales que se vuelven a crear cuando es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, fichiers journaux ou données temporaires qui sont recréés en cas de besoin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predmemorija, zapis ili privremeni podaci koji se po potrebi ponovno stvaraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsítótár, napló vagy ideiglenes adat, amely szükség esetén újra létrejön."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, log o dati temporanei che vengono ricreati quando necessario."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados em cache, registos ou dados temporários que são recriados quando necessário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, jurnal sau date temporare care se recreează la nevoie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnávacia pamäť, log alebo dočasné údaje, ktoré sa v prípade potreby vytvoria znova."
