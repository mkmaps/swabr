    "Nur beschädigte Listen werden entfernt. macOS legt sie leer neu an, betroffene Favoriten musst du neu hinzufügen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní se jen poškozené seznamy. macOS je vytvoří prázdné; dotčené oblíbené položky musíte přidat znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur beschädigte Listen werden entfernt. macOS legt sie leer neu an, betroffene Favoriten musst du neu hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρούνται μόνο οι κατεστραμμένες λίστες. Το macOS τις δημιουργεί ξανά κενές· τα επηρεαζόμενα αγαπημένα πρέπει να προστεθούν ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only damaged lists are removed. macOS recreates them empty; affected favourites have to be added again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminan las listas dañadas. macOS las vuelve a crear vacías; tendrás que volver a añadir los favoritos afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les listes endommagées sont supprimées. macOS les recrée à vide ; les favoris concernés doivent être ajoutés à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanjaju se samo oštećeni popisi. macOS ih ponovno stvara prazne; pogođeni favoriti moraju se ponovno dodati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a sérült listák törlődnek. A macOS üresen újra létrehozza őket; az érintett kedvenceket újra fel kell venni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono rimossi solo gli elenchi danneggiati. macOS li ricrea vuoti; i preferiti interessati devono essere aggiunti di nuovo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as listas danificadas são removidas. O macOS recria-as vazias; os favoritos afetados têm de ser adicionados novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt eliminate doar listele deteriorate. macOS le recreează goale; favoritele afectate trebuie adăugate din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstránia sa len poškodené zoznamy. macOS ich vytvorí prázdne; dotknuté obľúbené položky musíte pridať znova."
          }
        }
      }
    },
    "Nur mit dem offiziellen %@-Deinstallationsprogramm entfernen": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňte jen oficiálním odinstalátorem %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit dem offiziellen %@-Deinstallationsprogramm entfernen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση μόνο με το επίσημο πρόγραμμα απεγκατάστασης %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove only with the official %@ uninstaller"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstálalo solo con el desinstalador oficial de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne désinstallez l'application qu'à l'aide du programme de désinstallation officiel d'%@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklonite samo službenim deinstalacijskim programom %@"
          }
        },
