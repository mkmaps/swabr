    "Status des Index mit mdutil prüfen, nur bei Fehler oder ausgeschaltetem Index neu aufbauen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte stav indexu pomocí nástroje mdutil; index znovu vytvořte pouze v případě chyb nebo pokud je indexování vypnuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status des Index mit mdutil prüfen, nur bei Fehler oder ausgeschaltetem Index neu aufbauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε την κατάσταση του ευρετηρίου με το mdutil· εκτελέστε αναδημιουργία μόνο σε περίπτωση σφαλμάτων ή όταν η ευρετηρίαση είναι απενεργοποιημένη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the index status with mdutil; rebuild only on errors or when indexing is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el estado del índice con mdutil; vuelve a indexar solo si hay errores o cuando la indexación esté desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l'état de l'index à l'aide de mdutil ; ne procédez à une reconstruction qu'en cas d'erreurs ou lorsque l'indexation est désactivée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite status indeksa pomoću mdutila; ponovno izgradite samo ako dođe do pogrešaka ili je indeksiranje isključeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze az index állapotát az mdutil paranccsal; csak hiba esetén vagy ha az indexelés ki van kapcsolva, végezzen újraépítést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla lo stato dell’indice con mdutil; ricostruiscilo solo in caso di errori o quando l’indicizzazione è disattivata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o estado do índice com o mdutil; reconstrua apenas em caso de erros ou quando a indexação estiver desativada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați starea indexării cu mdutil; reconstruiți indexul numai în cazul apariției unor erori sau când indexarea este dezactivată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte stav indexu pomocou nástroja mdutil; preindexujte len v prípade chýb alebo ak je indexovanie vypnuté."
          }
        }
      }
    },
