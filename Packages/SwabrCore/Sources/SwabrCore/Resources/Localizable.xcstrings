    "Routing-Tabelle leeren und die Adresse der aktiven Schnittstellen neu per DHCP holen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprázdněte směrovací tabulku a obnovte adresy aktivních rozhraní prostřednictvím DHCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routing-Tabelle leeren und die Adresse der aktiven Schnittstellen neu per DHCP holen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκαθάριση του πίνακα δρομολόγησης και ανανέωση της διεύθυνσης των ενεργών διεπαφών μέσω DHCP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flush the routing table and renew the address of the active interfaces via DHCP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacíe la tabla de enrutamiento y renueve la dirección de las interfaces activas a través de DHCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videz la table de routage et renouvelez l'adresse des interfaces actives via DHCP."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispraznite tablicu usmjeravanja i obnovite adrese aktivnih sučelja putem DHCP-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törölje az útválasztási táblát, és frissítse az aktív interfészek címét DHCP-n keresztül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota la tabella di routing e aggiorna l’indirizzo delle interfacce attive tramite DHCP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe a tabela de encaminhamento e atualize o endereço das interfaces ativas através do DHCP."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Goliți tabelul de rutare și reînnoiți adresa interfețelor active prin DHCP."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprázdnite smerovaciu tabuľku a obnovte adresy aktívnych rozhraní prostredníctvom DHCP."
          }
        }
      }
    },
