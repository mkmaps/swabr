    "Finder legt dort keine .DS_Store-Dateien mehr an.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder tam už nevytváří soubory .DS_Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder legt dort keine .DS_Store-Dateien mehr an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Finder δεν δημιουργεί πλέον αρχεία .DS_Store εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder no longer creates .DS_Store files there."
          }
        },
