    "Kopien geöffneter Mail-Anhänge. Die Anhänge selbst bleiben in Mail erhalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie otevřených příloh Mailu. Samotné přílohy zůstanou v Mailu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien geöffneter Mail-Anhänge. Die Anhänge selbst bleiben in Mail erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντίγραφα ανοιγμένων συνημμένων του Mail. Τα ίδια τα συνημμένα παραμένουν στο Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies of opened Mail attachments. The attachments themselves stay in Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias de los archivos adjuntos abiertos en Mail. Los archivos adjuntos en sí se quedan en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies des pièces jointes ouvertes dans Mail. Les pièces jointes elles-mêmes restent dans Mail."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopije otvorenih privitaka Maila. Sami privici ostaju u Mailu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitott Mail-mellékletek másolatai. Maguk a mellékletek a Mailben maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie degli allegati aperti in Mail. Gli allegati stessi rimangono in Mail."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias de anexos abertos no Mail. Os próprios anexos permanecem no Mail."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copii ale atașamentelor Mail deschise. Atașamentele rămân în Mail."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kópie otvorených príloh Mailu. Samotné prílohy zostanú v Maile."
          }
        }
      }
    },
