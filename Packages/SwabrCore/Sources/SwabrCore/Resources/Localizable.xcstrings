            "state": "translated",
            "value": "Le Finder ne crée plus de fichiers .DS_Store à cet emplacement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder tamo više ne stvara datoteke .DS_Store."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finder ott már nem hoz létre .DS_Store fájlokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Finder non crea più file .DS_Store in quella posizione."
