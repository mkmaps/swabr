    "Ändert keine Inhalte. Beschädigte oder über 100 MB große Datenbanken bleiben unberührt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezmění obsah. Poškozené databáze nebo databáze větší než 100 MB zůstanou nedotčeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert keine Inhalte. Beschädigte oder über 100 MB große Datenbanken bleiben unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αλλάζει το περιεχόμενο. Οι κατεστραμμένες βάσεις δεδομένων ή αυτές που υπερβαίνουν τα 100 MB παραμένουν ως έχουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes no content. Damaged databases or ones over 100 MB stay untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No modifica el contenido. Las bases de datos dañadas o que superen los 100 MB no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'apporte aucune modification au contenu. Les bases de données endommagées ou dont la taille dépasse 100 Mo ne sont pas modifiées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mijenja sadržaj. Oštećene baze podataka ili one veće od 100 MB ostaju netaknute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tartalmat nem módosítja. A sérült vagy 100 MB-nál nagyobb adatbázisokat nem érinti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non modifica alcun contenuto. I database danneggiati o quelli superiori a 100 MB rimangono intatti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não altera o conteúdo. As bases de dados danificadas ou com mais de 100 MB permanecem inalteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu modifică conținutul. Bazele de date deteriorate sau cele cu dimensiunea mai mare de 100 MB rămân neschimbate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemení obsah. Poškodené databázy alebo databázy väčšie ako 100 MB zostávajú nedotknuté."
          }
        }
      }
    },
    "Ändert nichts, listet nur defekte Einträge. Entfernen kannst du sie im Bereich „Start“.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nemění, pouze vypisuje nefunkční položky. Odstraňte je v sekci „Spuštění“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nichts, listet nur defekte Einträge. Entfernen kannst du sie im Bereich „Start“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αλλάζει τίποτα, απλώς παραθέτει τις ελαττωματικές καταχωρήσεις. Διαγράψτε τις στην ενότητα «Εκκίνηση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes nothing, only lists broken entries. Remove them in the “Startup” section."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada, solo muestra las entradas que no funcionan. Elimínalas en la sección «Arranque»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne modifie rien, cela se contente de répertorier les entrées défectueuses. Supprimez-les dans la section « Démarrage »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mijenja ništa, samo prikazuje neispravne unose. Uklonite ih u odjeljku \"Pokretanje\"."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem változtat semmit, csak felsorolja a hibás bejegyzéseket. Távolítsa el őket az „Indítás” szakaszban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla, elenca solo le voci non funzionanti. Rimuovile nella sezione “Avvio”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não altera nada, apenas lista entradas com erros. Elimine-as na secção «Arranque»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu modifică nimic, ci doar afișează intrările defecte. Eliminați-le din secțiunea „Pornire”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nemení, iba vypisuje nefunkčné položky. Odstráňte ich v sekcii „Spustenie“."
          }
        }
      }
    },
    "Ändert nichts. Der Mac kann während der Prüfung für einige Sekunden langsamer reagieren.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nemění. Během kontroly může Mac několik sekund reagovat pomaleji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nichts. Der Mac kann während der Prüfung für einige Sekunden langsamer reagieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αλλάζει τίποτα. Το Mac μπορεί να αποκρίνεται πιο αργά για λίγα δευτερόλεπτα κατά τον έλεγχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes nothing. The Mac may respond slower for a few seconds during the check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada. Es posible que el Mac responda más lento durante unos segundos mientras se realiza la comprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne change rien. Le Mac peut être un peu plus lent pendant quelques secondes au cours de la vérification."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne mijenja. Mac tijekom provjere može nekoliko sekundi sporije reagirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmit sem módosít. Az ellenőrzés alatt a Mac néhány másodpercig lassabban reagálhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla. Il Mac potrebbe rispondere più lentamente per qualche secondo durante il controllo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não altera nada. O Mac poderá responder mais lentamente durante alguns segundos enquanto a verificação decorre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu schimbă nimic. Mac-ul poate răspunde mai lent câteva secunde în timpul verificării."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nemení. Počas kontroly môže Mac niekoľko sekúnd reagovať pomalšie."
          }
        }
      }
    },
    "Ändert nichts. Entfernen kannst du sie in Systemeinstellungen → Spotlight → Suchdatenschutz.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezmění to nic. Odstraňte je v Nastavení systému → Spotlight → Soukromí vyhledávání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nichts. Entfernen kannst du sie in Systemeinstellungen → Spotlight → Suchdatenschutz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αλλάζει τίποτα. Αφαιρέστε τα από τις Ρυθμίσεις συστήματος → Spotlight → Απόρρητο αναζήτησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes nothing. Remove them in System Settings → Spotlight → Search Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada. Quítalos en Ajustes del Sistema → Spotlight → Privacidad de búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne change rien. Supprimez-les dans Réglages Système → Spotlight → Confidentialité de la recherche."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mijenja ništa. Uklonite ih u Postavke sustava → Spotlight → Privatnost pretraživanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmit sem változtat. A Rendszerbeállítások → Spotlight → Keresési adatvédelem menüpontban távolíthatja el őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla. Rimuovili in Impostazioni di Sistema → Spotlight → Privacy di ricerca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não altera nada. Remova-os em «Definições do Sistema» → «Spotlight» → «Privacidade da Pesquisa»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu modifică nimic. Le puteți elimina din Configurări sistem → Spotlight → Confidențialitate căutare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič to nemení. Odstráňte ich v Nastaveniach systému → Spotlight → Súkromie vyhľadávania."
          }
        }
      }
    },
    "Ändert nichts. Gefundene Einträge kannst du im Finder prüfen und entfernen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nemění. Nalezené položky zkontrolujte a odstraňte ve Finderu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nichts. Gefundene Einträge kannst du im Finder prüfen und entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αλλάζει τίποτα. Ελέγξτε και αφαιρέστε τις καταχωρίσεις που βρέθηκαν στο Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes nothing. Check and remove the entries found in the Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada. Revisa y elimina las entradas que encuentres en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne change rien. Vérifiez et supprimez les entrées trouvées dans le Finder."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne mijenja. Provjerite i uklonite pronađene unose u Finderu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmit sem módosít. A talált bejegyzéseket a Finderben ellenőrizheti és távolíthatja el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla. Controlla e rimuovi le voci trovate nel Finder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não altera nada. Verifique e remova as entradas encontradas no Finder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu schimbă nimic. Verificați și eliminați intrările găsite în Finder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nemení. Nájdené položky skontrolujte a odstráňte vo Finderi."
          }
        }
      }
    },
    "Übersprungen: App läuft": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeskočeno: aplikace běží"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersprungen: App läuft"
          }
        },
        "el": {
