    "Leerraum in den Datenbanken freigeben (nur wenn die Apps geschlossen sind).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolnit nevyužité místo v databázích (jen když jsou aplikace zavřené)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerraum in den Datenbanken freigeben (nur wenn die Apps geschlossen sind)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελευθέρωση αχρησιμοποίητου χώρου στις βάσεις δεδομένων (μόνο όσο οι εφαρμογές είναι κλειστές)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up unused space in the databases (only while the apps are closed)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio no utilizado en las bases de datos (solo mientras las apps estén cerradas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace inutilisé dans les bases de données (uniquement lorsque les applications sont fermées)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oslobodi neiskorišteni prostor u bazama podataka (samo dok su aplikacije zatvorene)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabad hely felszabadítása az adatbázisokban (csak ha az appok be vannak zárva)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera spazio inutilizzato nei database (solo quando le app sono chiuse)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte espaço não utilizado nas bases de dados (apenas enquanto as aplicações estiverem fechadas)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberați spațiul nefolosit din bazele de date (doar cât timp aplicațiile sunt închise)."
