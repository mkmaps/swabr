    "Den Schalter neben „Swabr OP“ einschalten. Fehlt der Eintrag, Swabr aus dem Finder-Fenster, das sich mit öffnet, in die Liste ziehen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte „Swabr OP“. Pokud není v seznamu uveden, přetáhněte Swabr z okna Finderu, které se otevře vedle, do seznamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Schalter neben „Swabr OP“ einschalten. Fehlt der Eintrag, Swabr aus dem Finder-Fenster, das sich mit öffnet, in die Liste ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το «Swabr OP». Εάν δεν εμφανίζεται στη λίστα, σύρετε το Swabr από το παράθυρο του Finder που ανοίγει παράλληλα στη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on “Swabr OP”. If it isn't listed, drag Swabr from the Finder window that opens alongside into the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Swabr OP». Si no aparece en la lista, arrastra Swabr desde la ventana del Finder que se abre al lado hasta la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Swabr OP ». Si l’application n’apparaît pas dans la liste, faites glisser Swabr depuis la fenêtre du Finder qui s’ouvre à côté vers la liste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite \"Swabr OP\". Ako nije naveden, povucite Swabr iz prozora Findera koji se otvori pored i ispustite ga u popis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a „Swabr OP” alkalmazást. Ha nem szerepel a listában, húzza át a Swabr alkalmazást a mellette megnyíló Finder-ablakból a listába."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva “Swabr OP”. Se non è presente, trascina Swabr nell’elenco dalla finestra del Finder che si apre accanto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o «Swabr OP». Se este não constar da lista, arraste o Swabr da janela do Finder que se abre em paralelo para a lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați „Swabr OP”. Dacă nu apare în listă, trageți Swabr din fereastra Finder care se deschide alături în listă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite „Swabr OP“. Ak nie je v zozname, pretiahnite Swabr z okna Finderu, ktoré sa otvorí vedľa, do zoznamu."
          }
        }
      }
    },
    "Der Zuwachs liegt außerhalb deines Benutzerordners, etwa bei System-Updates oder lokalen Time-Machine-Schnappschüssen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento nárůst se týká prostoru mimo vaši domovskou složku, například systémových aktualizací nebo lokálních snímků Time Machine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zuwachs liegt außerhalb deines Benutzerordners, etwa bei System-Updates oder lokalen Time-Machine-Schnappschüssen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αύξηση αφορά χώρους εκτός του φακέλου «Home» σας, για παράδειγμα ενημερώσεις συστήματος ή τοπικά στιγμιότυπα του Time Machine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The growth is outside your home folder, for example system updates or local Time Machine snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aumento se produce fuera de tu carpeta de usuario, por ejemplo, en las actualizaciones del sistema o en las instantáneas locales de Time Machine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette augmentation concerne l'espace en dehors de votre dossier de départ, par exemple les mises à jour système ou les instantanés Time Machine locaux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rast je izvan vaše kućne mape, na primjer ažuriranja sustava ili lokalne Time Machine sigurnosne kopije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növekedés az otthoni mappán kívül történik, például rendszerfrissítések vagy helyi Time Machine pillanatképek miatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aumento di spazio si verifica al di fuori della tua cartella utente, ad esempio a causa degli aggiornamenti di sistema o delle istantanee locali di Time Machine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O aumento ocorre fora da sua pasta pessoal, por exemplo, atualizações do sistema ou instantâneos locais do Time Machine."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creșterea se produce în afara folderului dvs. personal, de exemplu actualizările de sistem sau instantaneele locale Time Machine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento nárast sa týka priestoru mimo vašej domovskej zložky, napríklad systémových aktualizácií alebo lokálnych snímok Time Machine."
          }
        }
      }
    },
    "Die App bleibt installiert. %lld Objekte (%@) mit Einstellungen, Caches und Daten landen im Papierkorb; beim nächsten Start ist die App wie neu installiert. Gemeinsam genutzte Daten und Browser-Profile bleiben.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace zůstane nainstalovaná. Počet položek: %lld (%@) s nastaveními, mezipamětmi a daty se přesune do koše; při příštím spuštění se aplikace chová jako nově nainstalovaná. Sdílená data a profily prohlížeče zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App bleibt installiert. %lld Objekte (%@) mit Einstellungen, Caches und Daten landen im Papierkorb; beim nächsten Start ist die App wie neu installiert. Gemeinsam genutzte Daten und Browser-Profile bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή παραμένει εγκατεστημένη. %lld στοιχεία (%@) με ρυθμίσεις, cache και δεδομένα μεταφέρονται στον Κάδο· στην επόμενη εκκίνηση η εφαρμογή ξεκινά σαν να εγκαταστάθηκε μόλις. Τα κοινόχρηστα δεδομένα και τα προφίλ προγράμματος περιήγησης παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app stays installed. %lld items (%@) with settings, caches and data go to the Trash; at the next launch the app starts as if freshly installed. Shared data and browser profiles stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app sigue instalada. %lld elementos (%@) con ajustes, cachés y datos van a la Papelera; en el próximo arranque la app se abre como recién instalada. Los datos compartidos y los perfiles de navegador se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application reste installée. %lld éléments (%@) comprenant les paramètres, les caches et les données sont envoyés à la Corbeille ; au prochain lancement, l’application démarre comme si elle venait d’être installée. Les données partagées et les profils de navigateur sont conservés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija ostaje instalirana. Broj stavki: %lld (%@) s postavkama, predmemorijom i podacima ide u Smeće; pri sljedećem pokretanju aplikacija se ponaša kao novo instalirana. Zajednički podaci i profili preglednika ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás telepítve marad. A beállításokat, gyorsítótárakat és adatokat tartalmazó %lld elem (%@) a Kukába kerül; a következő indításkor az alkalmazás úgy indul el, mintha frissen lenne telepítve. A megosztott adatok és a böngészőprofilok megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app rimane installata. %lld elementi (%@) con impostazioni, cache e dati finiscono nel Cestino; al prossimo avvio, l'app si avvia come se fosse appena stata installata. I dati condivisi e i profili del browser rimangono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação permanece instalada. %lld itens (%@) com definições, caches e dados vão para o Lixo; no próximo arranque, a aplicação abre como acabada de instalar. Os dados partilhados e os perfis do navegador mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația rămâne instalată. %lld elemente (%@) cu setări, cache-uri și date ajung în Coș; la următoarea pornire aplicația pornește ca proaspăt instalată. Datele partajate și profilurile de browser rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia zostane nainštalovaná. Počet položiek: %lld (%@) s nastaveniami, vyrovnávacími pamäťami a údajmi sa presunie do koša; pri ďalšom spustení sa aplikácia správa ako nanovo nainštalovaná. Zdieľané údaje a profily prehliadača zostanú."
          }
        }
      }
    },
    "Die App ist nicht mehr installiert; der Eintrag wird aus den Anmeldeobjekten gelöscht": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace už není nainstalována; položka se odstraní z položek po přihlášení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nicht mehr installiert; der Eintrag wird aus den Anmeldeobjekten gelöscht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή δεν είναι πλέον εγκατεστημένη· η καταχώριση διαγράφεται από τα στοιχεία σύνδεσης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is no longer installed; the entry is deleted from the login items"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya no está instalada; la entrada se ha eliminado de los ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application n'est plus installée ; l'entrée a été supprimée des éléments d'ouverture"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija više nije instalirana; unos se briše iz stavki prijave"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app már nincs telepítve; a bejegyzés törlődik a bejelentkezési elemek közül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non è più installata; la voce è stata eliminata dagli Elementi login"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação já não está instalada; a entrada foi eliminada dos elementos de início de sessão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația nu mai este instalată; intrarea este ștearsă din articolele de autentificare"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia už nie je nainštalovaná; položka sa odstráni z položiek po prihlásení"
          }
        }
      }
    },
    "Die App startet im Hintergrund, ohne ein Fenster zu öffnen": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace se spustí na pozadí bez otevření okna"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App startet im Hintergrund, ohne ein Fenster zu öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή ξεκινά στο παρασκήνιο χωρίς να ανοίξει παράθυρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app starts in the background without opening a window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se inicia en segundo plano sin abrir ninguna ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application se lance en arrière-plan sans ouvrir de fenêtre"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija se pokreće u pozadini bez otvaranja prozora"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app a háttérben indul, ablak megnyitása nélkül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app si avvia in background senza aprire una finestra"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação inicia-se em segundo plano sem abrir uma janela"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația pornește în fundal fără a deschide o fereastră"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia sa spustí na pozadí bez otvorenia okna"
          }
        }
      }
    },
    "Die App-Store-Version von Swabr darf nur Ordner lesen und ändern, die du freigibst. Für „%@“ braucht sie einmalig:": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze Swabr z App Store smí číst a měnit jen složky, které zpřístupníte. Pro „%@“ potřebuje jednorázově:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Store-Version von Swabr darf nur Ordner lesen und ändern, die du freigibst. Für „%@“ braucht sie einmalig:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση App Store του Swabr μπορεί να διαβάζει και να αλλάζει μόνο φακέλους στους οποίους παραχωρείτε πρόσβαση. Για το «%@» χρειάζεται μία φορά:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store edition of Swabr may only read and change folders you grant. For “%@” it needs once:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de Swabr de la App Store solo puede leer y modificar las carpetas que tú le concedas. Para «%@», necesita hacerlo una vez:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de Swabr disponible sur l’App Store ne peut lire et modifier que les dossiers que vous autorisez. Pour « %@ », elle en a besoin une seule fois :"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store izdanje Swabra smije čitati i mijenjati samo mape kojima odobrite pristup. Za „%@” jednom treba:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr App Store-verziója csak az Ön által megosztott mappákat olvashatja és módosíthatja. A(z) „%@” funkcióhoz egyszer szükséges:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione di Swabr disponibile sull’App Store può leggere e modificare solo le cartelle che consenti. Per “%@” ne ha bisogno una sola volta:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão do Swabr disponível na App Store só pode ler e alterar as pastas para as quais o utilizador concede autorização. Para «%@», necessita de acesso uma única vez:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea App Store a Swabr poate citi și modifica doar dosarele la care acordați acces. Pentru „%@” are nevoie o singură dată de:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzia Swabr z App Store smie čítať a meniť len priečinky, ktoré sprístupníte. Pre „%@“ potrebuje jednorazovo:"
          }
        }
      }
    },
    "Die Freigabe lässt sich jederzeit in den Einstellungen widerrufen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprávnění můžete kdykoli odvolat v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe lässt sich jederzeit in den Einstellungen widerrufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να ανακαλέσετε την άδεια οποιαδήποτε στιγμή στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can revoke the permission at any time in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes revocar el permiso en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez révoquer cette autorisation à tout moment dans les Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolu možete opozvati u bilo kojem trenutku u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az engedélyt bármikor visszavonhatja a Beállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi revocare l'autorizzazione in qualsiasi momento nelle Impostazioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode revogar a autorização a qualquer momento em «Definições»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți revoca permisiunea oricând din Configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprávnenie môžete kedykoľvek odvolať v Nastaveniach."
          }
        }
      }
    },
    "Die Originale landen im Papierkorb. Ein App-Update bringt den Intel-Code zurück.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Originály se přesunou do Koše. Aktualizace aplikace vrátí kód Intel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originale landen im Papierkorb. Ein App-Update bringt den Intel-Code zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρωτότυπα μεταφέρονται στον Κάδο. Μια ενημέρωση της εφαρμογής επαναφέρει τον κώδικα Intel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The originals go to the Trash. An app update brings the Intel code back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los originales van a la Papelera. Una actualización de la app recupera el código de Intel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d'origine sont envoyés dans la Corbeille. Une mise à jour de l'application réintroduit le code Intel."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvornici idu u Smeće. Ažuriranje aplikacije vraća Intel kod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredetik a Kukába kerülnek. Egy app-frissítés visszahozza az Intel-kódot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file originali finiscono nel Cestino. Un aggiornamento dell’app riporta il codice Intel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os originais vão para o Lixo. Uma atualização da aplicação traz de volta o código Intel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele ajung în Coș. O actualizare a aplicației readuce codul Intel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Originály sa presunú do Koša. Aktualizácia aplikácie vráti kód Intel."
          }
        }
      }
    },
    "Die Sprache wechselt beim nächsten Start.": {
