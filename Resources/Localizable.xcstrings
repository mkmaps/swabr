        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Universal-Apps enthalten Code für Intel- und Apple-Silicon-Macs. Auf diesem Mac wird nur der Apple-Silicon-Teil genutzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καθολικές εφαρμογές περιέχουν κώδικα για Mac με Intel και με Apple silicon. Αυτό το Mac χρησιμοποιεί μόνο το τμήμα Apple silicon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Universal apps contain code for Intel and Apple silicon Macs. This Mac uses only the Apple silicon part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps universales contienen código tanto para Macs con procesadores Intel como para los que llevan Apple Silicon. Este Mac solo usa la parte de Apple Silicon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications universelles contiennent du code destiné aux Mac équipés de processeurs Intel et Apple Silicon. Ce Mac utilise uniquement la partie Apple Silicon."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Univerzalne aplikacije sadrže kod za Intel Macove i Macove s Apple siliconom. Ovaj Mac koristi samo Apple silicon dio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az univerzális appok Intel- és Apple silicon alapú Macekhez is tartalmaznak kódot. Ez a Mac csak az Apple silicon részt használja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app universali contengono codice sia per i Mac con processori Intel che per quelli con Apple Silicon. Questo Mac utilizza solo la parte con Apple Silicon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações universais contêm código para Macs com processadores Intel e Apple Silicon. Este Mac utiliza apenas a parte com Apple Silicon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile universale conțin cod pentru Mac-uri cu Intel și cu Apple silicon. Acest Mac folosește doar partea Apple silicon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Univerzálne aplikácie obsahujú kód pre Macy s Intelom aj Apple silicon. Tento Mac používa len časť pre Apple silicon."
          }
        }
      }
    },
    "Unter „App-Hintergrundaktivitäten“ den Eintrag „Swabr OP“ einschalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V části „Aktivita aplikací na pozadí“ zapněte „Swabr OP“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „App-Hintergrundaktivitäten“ den Eintrag „Swabr OP“ einschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στην ενότητα «Δραστηριότητα εφαρμογών στο παρασκήνιο», ενεργοποιήστε το «Swabr OP»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under “App Background Activity”, switch on “Swabr OP”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Actividad en segundo plano de las apps», activa «Swabr OP»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous « Activité en arrière-plan des applications », activez « Swabr OP »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod \"Pozadinska aktivnost aplikacije\" uključite \"Swabr OP\"."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az „Alkalmazások háttértevékenysége” alatt kapcsolja be a „Swabr OP” opciót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In “Attività in background delle app”, attiva “Swabr OP”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em «Atividade em segundo plano das aplicações», ative «Swabr OP»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În secțiunea „Activitate în fundal a aplicațiilor”, activați „Swabr OP”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti „Aktivita aplikácií na pozadí“ zapnite „Swabr OP“."
          }
        }
      }
    },
    "Updater und Hilfsprogramme, die Apps selbst einrichten. Eigene Dienste lassen sich hier blockieren oder entfernen, systemweite nur in den Systemeinstellungen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizátory a pomocné nástroje, které si aplikace nastavují samy. Vlastní služby zde lze blokovat nebo odstranit, systémové jen v Nastavení systému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updater und Hilfsprogramme, die Apps selbst einrichten. Eigene Dienste lassen sich hier blockieren oder entfernen, systemweite nur in den Systemeinstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προγράμματα ενημέρωσης και βοηθητικά εργαλεία που ρυθμίζουν οι ίδιες οι εφαρμογές. Οι δικές σας υπηρεσίες μπορούν να αποκλειστούν ή να αφαιρεθούν εδώ, όσες αφορούν όλο το σύστημα μόνο στις Ρυθμίσεις συστήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updaters and helper tools that apps set up themselves. Your own services can be blocked or removed here, system-wide ones only in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizadores y herramientas auxiliares que las propias aplicaciones configuran. Aquí puedes bloquear o eliminar tus propios servicios; los que afectan a todo el sistema solo se pueden gestionar en «Ajustes del Sistema»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmes de mise à jour et outils d’aide que les applications configurent elles-mêmes. Vous pouvez bloquer ou supprimer vos propres services ici ; les services à l’échelle du système ne peuvent l’être que dans les Réglages Système."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programi za ažuriranje i pomoćni alati koje aplikacije same postavljaju. Vlastite usluge ovdje se mogu blokirati ili ukloniti, one za cijeli sustav samo u Postavkama sustava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Frissítők és segédprogramok, amelyeket az appok maguk állítanak be. A saját szolgáltatások itt letilthatók vagy eltávolíthatók, a rendszerszintűek csak a Rendszerbeállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmi di aggiornamento e strumenti di supporto che le app configurano autonomamente. Qui puoi bloccare o rimuovere i tuoi servizi; quelli a livello di sistema possono essere gestiti solo nelle Impostazioni di Sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Programas de atualização e ferramentas auxiliares que as próprias aplicações configuram. Os seus próprios serviços podem ser bloqueados ou removidos aqui; os serviços a nível do sistema, apenas nas Definições do Sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programe de actualizare și instrumente ajutătoare pe care aplicațiile le configurează singure. Serviciile proprii pot fi blocate sau eliminate aici, cele la nivel de sistem doar în Configurări sistem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizátory a pomocné nástroje, ktoré si aplikácie nastavujú samy. Vlastné služby tu možno blokovať alebo odstrániť, systémové len v Nastaveniach systému."
          }
        }
      }
    },
