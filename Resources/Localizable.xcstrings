    "Es wird zuerst nur gesucht. Gelöscht wird erst, nachdem du die Liste geprüft und bestätigt hast.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nejprve jen hledá. Nic se nesmaže, dokud seznam nezkontrolujete a nepotvrdíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird zuerst nur gesucht. Gelöscht wird erst, nachdem du die Liste geprüft und bestätigt hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr πρώτα μόνο αναζητά. Τίποτα δεν διαγράφεται πριν ελέγξετε τη λίστα και επιβεβαιώσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr only searches first. Nothing is deleted until you have checked the list and confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr solo realiza una búsqueda inicial. No se borra nada hasta que hayas revisado la lista y lo hayas confirmado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr se contente dans un premier temps d'effectuer une recherche. Rien n'est supprimé tant que vous n'avez pas vérifié la liste et donné votre confirmation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr najprije samo traži. Ništa se ne briše dok ne provjerite popis i potvrdite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr először csak keres. Semmi sem törlődik, amíg nem ellenőrizte és nem hagyta jóvá a listát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr esegue solo una ricerca iniziale. Nulla viene eliminato finché non hai controllato l’elenco e confermato l’operazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr limita-se, numa primeira fase, a efetuar uma pesquisa. Nada é eliminado até que tenha verificado a lista e confirmado a ação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr doar caută la început. Nimic nu este șters până nu verificați lista și confirmați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr najprv len hľadá. Nič sa nezmaže, kým zoznam neskontrolujete a nepotvrdíte."
          }
        }
      }
    },
    "Es wurde nichts zum Aufräumen gefunden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebylo nalezeno nic k úklidu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts zum Aufräumen gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε τίποτα για καθαρισμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to clean up was found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado nada que limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément à nettoyer n’a été détecté."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađeno ništa za čišćenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található tisztítandó elem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato nulla da pulire."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado nada para limpar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit nimic de curățat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenašlo sa nič na upratanie."
          }
        }
      }
    },
    "Fehlenden Festplattenvollzugriff beim Start melden": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásit chybějící oprávnění „Plný přístup k disku“ při spuštění"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlenden Festplattenvollzugriff beim Start melden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναφορά για την απουσία της επιλογής «Πλήρης πρόσβαση στον δίσκο» κατά την εκκίνηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report missing Full Disk Access at start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informar de que falta el «Acceso total al disco» al iniciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler l'absence de l'autorisation « Accès complet au disque » au démarrage"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite nedostupnost punog pristupa disku pri pokretanju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentse, ha az indításkor hiányzik a „Teljes lemezhozzáférés” jogosultság"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnala la mancanza dell’autorizzazione “Accesso completo al disco” all’avvio"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatar a falta de «Acesso total ao disco» no arranque"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportați lipsa accesului complet la disc la pornire"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahláste chýbajúci Úplný prístup k disku pri spustení"
