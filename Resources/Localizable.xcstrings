    "Apps aktualisieren, Anmeldeobjekte verwalten, Optimierungen mit Administratorrechten und Verschlanken brauchen Rechte, die Apps aus dem App Store nicht erhalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace aplikací, správa položek přihlášení, optimalizace s administrátorskými právy a zeštíhlení vyžadují oprávnění, která aplikace z App Store nedostanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps aktualisieren, Anmeldeobjekte verwalten, Optimierungen mit Administratorrechten und Verschlanken brauchen Rechte, die Apps aus dem App Store nicht erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενημέρωση εφαρμογών, η διαχείριση στοιχείων σύνδεσης, οι βελτιστοποιήσεις με δικαιώματα διαχειριστή και η ελάφρυνση χρειάζονται άδειες που οι εφαρμογές του App Store δεν λαμβάνουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating apps, managing login items, optimizations with administrator rights and slimming down need permissions that App Store apps don't get."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar apps, gestionar ítems de inicio, realizar optimizaciones con derechos de administrador y reducir el sistema requieren permisos que las apps de la App Store no tienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour des applications, la gestion de l'ouverture, les optimisations nécessitant des droits d'administrateur et l'allègement du système requièrent des autorisations dont ne disposent pas les applications de l'App Store."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje aplikacija, upravljanje stavkama prijave, optimizacije s administratorskim pravima i smanjivanje zahtijevaju dozvole koje aplikacije iz App Storea ne dobivaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appok frissítése, a bejelentkezési elemek kezelése, a rendszergazdai jogot igénylő optimalizálások és a karcsúsítás olyan jogokat igényel, amelyeket az App Store-appok nem kapnak meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento delle app, la gestione degli Elementi login, le ottimizzazioni con i diritti di amministratore e l'alleggerimento dello spazio occupato richiedono autorizzazioni che le app dell'App Store non hanno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização de aplicações, a gestão de elementos de início de sessão, as otimizações com direitos de administrador e a redução do espaço ocupado requerem permissões que as aplicações da App Store não obtêm."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizarea aplicațiilor, gestionarea articolelor de autentificare, optimizările cu drepturi de administrator și reducerea necesită permisiuni pe care aplicațiile din App Store nu le primesc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizácia aplikácií, správa položiek prihlásenia, optimalizácie s administrátorskými právami a zoštíhlenie vyžadujú oprávnenia, ktoré aplikácie z App Store nedostanú."
          }
        }
      }
    },
