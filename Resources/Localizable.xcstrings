    "Swabr für den Mac: aufräumen, Apps entfernen, Speicher analysieren und den Zustand im Blick behalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr pro váš Mac: uklízejte, odstraňujte aplikace, analyzujte úložiště a sledujte jeho stav."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr für den Mac: aufräumen, Apps entfernen, Speicher analysieren und den Zustand im Blick behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr για το Mac σας: καθαρισμός, αφαίρεση εφαρμογών, ανάλυση χώρου και παρακολούθηση της υγείας του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr for your Mac: clean up, remove apps, analyse storage and keep an eye on its health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr para tu Mac: limpia el ordenador, elimina aplicaciones, analiza el almacenamiento y vigila su estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr pour votre Mac : nettoyez votre ordinateur, supprimez des applications, analysez l'espace de stockage et surveillez son état de santé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr za vaš Mac: čišćenje, uklanjanje aplikacija, analiza prostora i praćenje zdravlja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr a Mac-hez: takarítás, appok eltávolítása, tárhely elemzése és az állapot figyelése."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr per il tuo Mac: pulisci il sistema, rimuovi le app, analizza lo spazio di archiviazione e tieni d’occhio lo stato di salute del tuo Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr para o seu Mac: limpe, remova aplicações, analise o espaço de armazenamento e acompanhe o estado do seu computador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr pentru Mac-ul dvs.: curățați, eliminați aplicații, analizați spațiul și urmăriți starea de sănătate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr pre váš Mac: upratujte, odstraňujte aplikácie, analyzujte úložisko a sledujte jeho stav."
          }
        }
      }
    },
    "Swabr hat keine Daten dieser App gefunden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace Swabr nenašla žádná data o této aplikaci."
          }
