    "Orte, die die Whitelist, eine laufende App oder die Sicherheitsprüfung schützen, mit Grund": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístění chráněná pomocí seznamu povolených položek, spuštěnou aplikací nebo bezpečnostní kontrolou, včetně důvodu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orte, die die Whitelist, eine laufende App oder die Sicherheitsprüfung schützen, mit Grund"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέσεις που προστατεύονται από τη λίστα επιτρεπόμενων, μια εφαρμογή που εκτελείται ή τον έλεγχο ασφαλείας, με την αιτία"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locations protected by the whitelist, a running app or the safety check, with the reason"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicaciones protegidas por la lista blanca, una app en ejecución o la comprobación de seguridad, con el motivo correspondiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacements protégés par la liste blanche, une application en cours d'exécution ou le contrôle de sécurité, avec la raison"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacije zaštićene bjelačkom listom, aktivnom aplikacijom ili provjerom sigurnosti, s razlogom"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fehérlistával, egy futó alkalmazással vagy a biztonsági ellenőrzéssel védett helyek, az indoklással együtt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizioni protette dalla whitelist, da un’app in esecuzione o dal controllo di sicurezza, con la relativa motivazione"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Locais protegidos pela lista de permissões, por uma aplicação em execução ou pela verificação de segurança, com a respetiva justificação"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locații protejate de lista albă, de o aplicație care rulează sau de verificarea de siguranță, cu motivul"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesta chránené bielym zoznamom, spustenou aplikáciou alebo bezpečnostnou kontrolou, spolu s dôvodom"
          }
        }
      }
    },
    "Orte, die die Whitelist, eine laufende App oder die Sicherheitsprüfung schützen. Aufklappen zeigt sie mit Grund.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístění chráněná whitelistem, spuštěnou aplikací nebo bezpečnostní kontrolou. Rozbalením položky je uvidíte i s důvodem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orte, die die Whitelist, eine laufende App oder die Sicherheitsprüfung schützen. Aufklappen zeigt sie mit Grund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέσεις που προστατεύονται από τη λίστα επιτρεπόμενων, μια εφαρμογή σε εκτέλεση ή τον έλεγχο ασφαλείας. Αναπτύξτε μια καταχώριση για να τις δείτε με την αιτία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locations protected by the whitelist, a running app or the safety check. Expand an entry to see them with the reason."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicaciones protegidas por la lista blanca, una app abierta o la comprobación de seguridad. Despliega una entrada para verlas con el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacements protégés par la liste blanche, une app ouverte ou le contrôle de sécurité. Développez une entrée pour les voir avec leur motif."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacije koje štiti popis dopuštenih, pokrenuta aplikacija ili sigurnosna provjera. Proširite stavku da ih vidite s razlogom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fehérlista, egy futó app vagy a biztonsági ellenőrzés által védett helyek. Egy tétel kibontásával indoklással együtt láthatók."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizioni protette dalla lista bianca, da un'app in esecuzione o dal controllo di sicurezza. Espandi una voce per vederle con il motivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizações protegidas pela lista de permissões, por uma app em execução ou pela verificação de segurança. Expanda uma entrada para as ver com o motivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locații protejate de lista albă, de o aplicație care rulează sau de verificarea de siguranță. Extindeți o intrare pentru a le vedea cu motivul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiestnenia chránené whitelistom, spustenou aplikáciou alebo bezpečnostnou kontrolou. Rozbalením položky ich uvidíte aj s dôvodom."
          }
        }
      }
    },
    "PID %d": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
