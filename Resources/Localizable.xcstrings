    "Aktualisiert alle angekreuzten Apps nacheinander. Laufende Apps werden beendet und danach wieder geöffnet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje všechny zaškrtnuté aplikace postupně. Běžící aplikace se ukončí a poté znovu otevřou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert alle angekreuzten Apps nacheinander. Laufende Apps werden beendet und danach wieder geöffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώνει όλες τις επιλεγμένες εφαρμογές τη μία μετά την άλλη. Οι εφαρμογές που εκτελούνται τερματίζονται και ανοίγουν ξανά μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates all ticked apps one after another. Running apps are quit and reopened afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza todas las apps marcadas una tras otra. Las apps que estén en ejecución se cierran y se vuelven a abrir después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour toutes les applications cochées les unes après les autres. Les applications en cours d'exécution sont fermées puis rouvertes par la suite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurira sve označene aplikacije jednu za drugom. Pokrenute aplikacije se zatvaraju i zatim ponovno otvaraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorban frissíti az összes bejelölt appot. A futó appokat bezárja, majd újra megnyitja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna tutte le app selezionate una dopo l’altra. Le app in esecuzione vengono chiuse e riaperte in seguito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza todas as aplicações assinaladas, uma a seguir à outra. As aplicações em execução são encerradas e reabertas posteriormente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează toate aplicațiile bifate, una după alta. Aplicațiile deschise sunt închise și redeschise după aceea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje všetky zaškrtnuté aplikácie postupne. Bežiace aplikácie sa ukončia a potom znova otvoria."
          }
        }
      }
    },
