    "Landet im Papierkorb und lässt sich bis zum Leeren wiederherstellen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesune se do Koše a lze to obnovit, dokud jej nevyprázdníte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet im Papierkorb und lässt sich bis zum Leeren wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρεται στον Κάδο και μπορεί να ανακτηθεί μέχρι να αδειάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes to the Trash and can be restored until it is emptied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a la Papelera y se puede recuperar hasta que se vacíe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est envoyé dans la Corbeille et peut être restauré tant que celle-ci n'a pas été vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide u Smeće i može se vratiti dok se ne isprazni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kukába kerül, és visszaállítható, amíg nem üríti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finisce nel Cestino e può essere ripristinato finché non viene svuotato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É enviado para o Caixote do Lixo e pode ser restaurado até que este seja esvaziado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajunge în Coș și poate fi restaurat până la golire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunie sa do Koša a dá sa obnoviť, kým ho nevyprázdnite."
          }
        }
      }
    },
    "Landet im Papierkorb, Speicher wird erst beim Leeren frei.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesune se do Koše; místo se uvolní až po vyprázdnění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet im Papierkorb, Speicher wird erst beim Leeren frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρεται στον Κάδο· ο χώρος ελευθερώνεται μόνο όταν αδειάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes to the Trash; space is freed only when it is emptied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a la Papelera; el espacio solo se libera cuando se vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément est déplacé vers la Corbeille ; l'espace n'est libéré que lorsque celle-ci est vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide u Smeće; prostor se oslobađa tek pri pražnjenju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kukába kerül; a hely csak ürítéskor szabadul fel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene spostato nel Cestino; lo spazio viene liberato solo quando il Cestino viene svuotato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai para o Caixote do Lixo; o espaço só é libertado quando este for esvaziado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajunge în Coș; spațiul este eliberat doar la golire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunie sa do Koša; miesto sa uvoľní až po vyprázdnení."
          }
        }
      }
    },
    "Landet im Papierkorb. Speicher wird erst beim Leeren frei.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesune se do Koše. Místo se uvolní až po vyprázdnění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet im Papierkorb. Speicher wird erst beim Leeren frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρεται στον Κάδο. Ο χώρος ελευθερώνεται μόνο όταν αδειάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes to the Trash. Space is freed only when it is emptied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a la Papelera. Solo se libera espacio cuando se vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est envoyé dans la Corbeille. L'espace n'est libéré que lorsque celle-ci est vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide u Smeće. Prostor se oslobađa tek pri pražnjenju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kukába kerül. A hely csak ürítéskor szabadul fel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene spostato nel Cestino. Lo spazio viene liberato solo quando il Cestino viene svuotato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai para o Caixote do Lixo. O espaço só é libertado quando este for esvaziado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajunge în Coș. Spațiul este eliberat doar la golire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunie sa do Koša. Miesto sa uvoľní až po vyprázdnení."
          }
        }
      }
    },
