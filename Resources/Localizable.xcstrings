    "%@ arbeitet weiter, bis du sie ausschaltest. Nur macOS selbst darf Systemerweiterungen entfernen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ běží, dokud jej nevypnete. Systémová rozšíření smí odstraňovat pouze samotný macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arbeitet weiter, bis du sie ausschaltest. Nur macOS selbst darf Systemerweiterungen entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ συνεχίζει να λειτουργεί μέχρι να το απενεργοποιήσετε. Μόνο το ίδιο το macOS μπορεί να καταργήσει τις επεκτάσεις συστήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keeps running until you switch it off. Only macOS itself may remove system extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue funcionando hasta que lo apagues. Solo el propio macOS puede eliminar las extensiones del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continue de fonctionner jusqu’à ce que vous le désactiviez. Seul macOS lui-même peut supprimer les extensions système."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nastavlja raditi dok ga ne isključite. Samo macOS može ukloniti sistemske ekstenzije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ addig fut, amíg ki nem kapcsolod. A rendszerbővítményeket kizárólag a macOS maga távolíthatja el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua a funzionare finché non lo spegni. Solo macOS stesso può rimuovere le estensioni di sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ continua a funcionar até que o desligue. Apenas o próprio macOS pode remover extensões do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rămâne activ până când îl opriți. Numai sistemul de operare macOS poate elimina extensiile de sistem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beží, kým ho nevypnete. Systémové rozšírenia môže odstraňovať iba samotný macOS."
          }
        }
      }
    },
