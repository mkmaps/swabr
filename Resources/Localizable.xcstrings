    "Apps, die sich selbst anmelden (z. B. über „Beim Anmelden öffnen“ in der App), zeigt Swabr nur mit eingerichtetem Hilfsdienst für Administratorrechte.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace, které se samy registrují (například pomocí možnosti „Spustit při přihlášení“ v aplikaci), se zobrazí pouze v případě, že je nastavena pomocná služba pro správcovská oprávnění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die sich selbst anmelden (z. B. über „Beim Anmelden öffnen“ in der App), zeigt Swabr nur mit eingerichtetem Hilfsdienst für Administratorrechte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που καταχωρίζονται αυτόματα (για παράδειγμα με την επιλογή «Άνοιγμα κατά τη σύνδεση» στην εφαρμογή) εμφανίζονται μόνο όταν έχει ρυθμιστεί η βοηθητική υπηρεσία για δικαιώματα διαχειριστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that register themselves (for example with “Open at Login” in the app) appear only when the helper service for administrator rights is set up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que se registran automáticamente (por ejemplo, con la opción «Abrir al iniciar sesión» de la propia app) solo aparecen cuando tienes configurado el servicio auxiliar para los derechos de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications qui s’enregistrent automatiquement (par exemple via l’option « Ouvrir à la connexion » dans l’application) n’apparaissent que lorsque le service d’assistance pour les droits d’administrateur est configuré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije koje se same registriraju (na primjer pomoću opcije \"Otvori pri prijavi\" unutar aplikacije) pojavljuju se samo kada je uspostavljena pomoćna usluga za administratorska prava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azok az alkalmazások, amelyek regisztrálják magukat (például az alkalmazáson belüli „Indítás bejelentkezéskor” opcióval), csak akkor jelennek meg, ha be van állítva a rendszergazdai jogokhoz szükséges segítő szolgáltatás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che si registrano automaticamente (ad esempio con l’opzione “Apri al login” nell’app) compaiono solo se è configurato il servizio di supporto per i diritti di amministratore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações que se registam automaticamente (por exemplo, com a opção «Abrir ao iniciar sessão» na aplicação) só aparecem quando o serviço auxiliar para direitos de administrador estiver configurado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile care se înregistrează automat (de exemplu, cu opțiunea „Deschideți la autentificare” din aplicație) apar numai atunci când este configurat serviciul auxiliar pentru drepturile de administrator."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie, ktoré sa registrujú samy (napríklad pomocou funkcie „Spustiť pri prihlásení“ v aplikácii), sa zobrazia len vtedy, ak je nastavená pomocná služba pre práva správcu."
          }
        }
      }
    },
