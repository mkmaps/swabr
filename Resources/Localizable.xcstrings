    "Angehakte Einträge aller Kategorien. Änderungen hier gelten auch auf der Seite.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaškrtnuté položky ve všech kategoriích. Změny zde se projeví také na stránce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehakte Einträge aller Kategorien. Änderungen hier gelten auch auf der Seite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλεγμένες καταχωρήσεις όλων των κατηγοριών. Οι αλλαγές εδώ ισχύουν και στη σελίδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ticked entries of all categories. Changes here also apply on the page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementos marcados de todas las categorías. Los cambios que hagas aquí también se aplicarán en la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments cochés de toutes les catégories. Les modifications apportées ici s'appliquent également à la page."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označene stavke svih kategorija. Promjene ovdje također se primjenjuju na stranici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes kategória bejelölt elemei. Az itt végzett módosítások az oldalon is érvényesek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voci selezionate di tutte le categorie. Le modifiche apportate qui si applicano anche alla pagina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas assinaladas em todas as categorias. As alterações aqui efetuadas aplicam-se também à página."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele bifate din toate categoriile. Modificările efectuate aici se aplică și pe pagină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaškrtnuté položky vo všetkých kategóriách. Zmeny vykonané tu sa uplatnia aj na stránke."
          }
        }
      }
    },
