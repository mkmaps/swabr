    "Bitte in Systemeinstellungen → Allgemein → Anmeldeobjekte erlauben.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte to prosím v Nastavení systému → Obecné → Položky přihlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte in Systemeinstellungen → Allgemein → Anmeldeobjekte erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε το στις Ρυθμίσεις συστήματος → Γενικά → Στοιχεία σύνδεσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please allow it in System Settings → General → Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, habilítala en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez l'autoriser dans Réglages Système → Général → Ouverture."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite to u Postavkama sustava → Općenito → Stavke prijave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a Rendszerbeállítások → Általános → Bejelentkezési elemek alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati di abilitarla in Impostazioni di Sistema → Generali → Elementi login."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, autorize esta funcionalidade em Definições do Sistema → Gerais → Elementos de início de sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți în Configurări sistem → General → Articole de autentificare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte to v Nastaveniach systému → Všeobecné → Položky prihlásenia."
          }
        }
      }
    },
