    "Gerade gibt es nichts Nennenswertes aufzuräumen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tuto chvíli není co k úklidu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade gibt es nichts Nennenswertes aufzuräumen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει τίποτα που αξίζει για Καθαρισμό αυτή τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing worth cleaning up right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no hay nada que merezca la pena limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a rien à nettoyer pour le moment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutno nema ničega što vrijedi očistiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenleg nincs semmi, amit érdemes lenne megtisztítani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non c'è nulla che valga la pena pulire."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada que valha a pena limpar neste momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În acest moment nu există nimic ce merită supus curățării."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V súčasnosti nie je nič, čo by stálo na upratanie."
          }
        }
      }
    },
