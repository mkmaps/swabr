    "Speicher wird frei, sobald du den Papierkorb leerst.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo se uvolní, jakmile vyprázdníte Koš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher wird frei, sobald du den Papierkorb leerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χώρος ελευθερώνεται μόλις αδειάσετε τον Κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is freed as soon as you empty the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se libera espacio en cuanto vacías la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'espace est libéré dès que vous videz la Corbeille."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostor se oslobađa čim ispraznite Smeće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hely felszabadul, amint kiüríti a Kukát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio viene liberato non appena svuoti il Cestino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço é libertado assim que esvaziar o Caixote do Lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul este eliberat imediat ce goliți Coșul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesto sa uvoľní, hneď ako vyprázdnite Kôš."
          }
        }
      }
    },
