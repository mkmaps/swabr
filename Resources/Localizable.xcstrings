    " Persönliche Daten bleiben erhalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Osobní data zůstanou zachována."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Persönliche Daten bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": " Τα προσωπικά δεδομένα διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Personal data is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Se conservan los datos personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les données personnelles sont conservées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " Osobni podaci su zadržani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " A személyes adatok megmaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " I dati personali vengono conservati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " Os dados pessoais são conservados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Datele personale sunt păstrate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " Osobné údaje zostanú zachované."
          }
        }
