    "System, laufende Apps und deine Ausnahmen bleiben unangetastet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém, spuštěné aplikace a vaše výjimky zůstávají nedotčeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System, laufende Apps und deine Ausnahmen bleiben unangetastet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύστημα, οι εφαρμογές που εκτελούνται και οι εξαιρέσεις σας δεν επηρεάζονται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system, running apps and your exceptions are never touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema, las aplicaciones en ejecución y tus excepciones nunca se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système, les applications en cours d'exécution et vos exceptions ne sont jamais modifiés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustav, pokrenute aplikacije i vaši izuzeci nikada se ne diraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer, a futó alkalmazások és a kivételek soha nem kerülnek módosításra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema, le app in esecuzione e le tue eccezioni non vengono mai modificati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema, as aplicações em execução e as suas exceções nunca são alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemul, aplicațiile care rulează și excepțiile dvs. nu sunt niciodată afectate."
