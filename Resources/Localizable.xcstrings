    "Aus: Alles landet im Papierkorb und lässt sich bis zum Leeren zurückholen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto: vše se přesune do koše a lze jej vrátit zpět, dokud koš nevyprázdníte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Alles landet im Papierkorb und lässt sich bis zum Leeren zurückholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιημένο: όλα μεταφέρονται στον Κάδο και μπορούν να επαναφερθούν μέχρι να τον αδειάσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: everything goes to the Trash and can be put back until you empty it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: todo va a la Papelera y se puede recuperar hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : tout est envoyé dans la Corbeille et peut être restauré tant que vous ne l'avez pas vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno: sve se šalje u Kantu za smeće i može se vratiti dok ga ne ispraznite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki: minden a Kuka-ba kerül, és visszahelyezhető, amíg ki nem üríted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: tutto finisce nel Cestino e può essere ripristinato finché non lo svuoti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: tudo vai para o Caixote do Lixo e pode ser recuperado até que o esvazie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprit: totul este mutat în Coșul de gunoi și poate fi recuperat până când îl goliți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuté: všetko sa presunie do koša a dá sa vrátiť späť, kým ho nevyprázdnite."
          }
        }
      }
    },
