    "Alles landet im Papierkorb und ist bis zum Leeren wiederherstellbar.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše se přesune do Koše a lze to obnovit, dokud jej nevyprázdníte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles landet im Papierkorb und ist bis zum Leeren wiederherstellbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα μεταφέρονται στον Κάδο και μπορούν να ανακτηθούν μέχρι να αδειάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything goes to the Trash and can be restored until it is emptied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va a la Papelera y se puede recuperar hasta que se vacíe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est envoyé dans la Corbeille et peut être restauré tant que celle-ci n’a pas été vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ide u Smeće i može se vratiti dok se ne isprazni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden a Kukába kerül, és visszaállítható, amíg nem üríti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto finisce nel Cestino e può essere ripristinato finché non viene svuotato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é enviado para o Caixote do Lixo e pode ser restaurado até que este seja esvaziado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul ajunge în Coș și poate fi restaurat până la golire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko sa presunie do Koša a dá sa obnoviť, kým ho nevyprázdnite."
          }
        }
      }
    },
