    "Installationsdatei aus %@. Bereits installierte Programme bleiben erhalten; für eine Neuinstallation musst du sie erneut laden.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalační soubor z %@. Nainstalované programy zůstanou; pro novou instalaci jej musíte stáhnout znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsdatei aus %@. Bereits installierte Programme bleiben erhalten; für eine Neuinstallation musst du sie erneut laden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχείο εγκατάστασης από %@. Τα εγκατεστημένα προγράμματα παραμένουν· για επανεγκατάσταση πρέπει να το λάβετε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation file from %@. Installed programs stay; to reinstall you have to download it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de instalación de %@. Los programas instalados se mantienen; para volver a instalarlos, tienes que descargarlos de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier d'installation provenant de %@. Les programmes installés sont conservés ; pour les réinstaller, vous devez télécharger à nouveau le fichier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacijska datoteka od %@. Instalirani programi ostaju; za ponovnu instalaciju morate je ponovno preuzeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítőfájl innen: %@. A telepített programok megmaradnak; újratelepítéshez újra le kell töltenie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File di installazione da %@. I programmi installati rimangono; per reinstallarli devi scaricarli di nuovo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro de instalação de %@. Os programas instalados permanecem; para reinstalá-los, terá de os descarregar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișier de instalare de la %@. Programele instalate rămân; pentru reinstalare trebuie descărcat din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalačný súbor z %@. Nainštalované programy zostanú; na novú inštaláciu ho musíte stiahnuť znova."
          }
        }
      }
    },
