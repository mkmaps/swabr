            "state": "translated",
            "value": "Το Swabr δεν βρήκε δεδομένα για αυτήν την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr found no data of this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr no ha encontrado datos sobre esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr n'a trouvé aucune donnée concernant cette application."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nije pronašao nikakve podatke o ovoj aplikaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr nem talált adatokat erről az alkalmazásról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr non ha trovato dati relativi a questa app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr não encontrou quaisquer dados relativos a esta aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nu a găsit date despre această aplicație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia Swabr nenašla žiadne údaje o tejto aplikácii."
          }
        }
      }
    },
    "Swabr kann nur in diesen Ordnern lesen und löschen. Ohne Freigabe von Programme und Benutzerordner sind Aufräumen, Optimieren und Deinstallieren gesperrt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr může číst a mazat jen v těchto složkách. Bez přístupu k Aplikacím a domovské složce jsou Úklid, Optimalizace a Odinstalace uzamčeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr kann nur in diesen Ordnern lesen und löschen. Ohne Freigabe von Programme und Benutzerordner sind Aufräumen, Optimieren und Deinstallieren gesperrt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr μπορεί να διαβάζει και να διαγράφει μόνο σε αυτούς τους φακέλους. Χωρίς πρόσβαση στις Εφαρμογές και στον προσωπικό σας φάκελο, ο Καθαρισμός, η Βελτιστοποίηση και η Απεγκατάσταση είναι κλειδωμένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr can read and delete only in these folders. Without access to Applications and your home folder, Clean Up, Optimize and Uninstall are locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr solo puede leer y eliminar archivos en estas carpetas. Si no tienes acceso a la carpeta «Aplicaciones» ni a tu carpeta de usuario, las funciones «Limpiar», «Optimizar» y «Desinstalar» estarán bloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr ne peut lire et supprimer des fichiers que dans ces dossiers. Sans accès au dossier « Applications » et à votre dossier de l'utilisateur, les fonctions « Nettoyer », « Optimiser » et « Désinstaller » sont verrouillées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr smije čitati i brisati samo u ovim mapama. Bez pristupa Aplikacijama i kućnoj mapi, Čišćenje, Optimizacija i Deinstalacija su zaključani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr csak ezekben a mappákban olvashat és törölhet. Az Alkalmazások és a saját mappa megosztása nélkül a Tisztítás, az Optimalizálás és az Eltávolítás zárolva van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr può leggere ed eliminare file solo in queste cartelle. Senza accesso alla cartella Applicazioni e alla tua cartella Home, le funzioni Pulisci, Ottimizza e Disinstalla sono bloccate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr só pode ler e eliminar ficheiros nestas pastas. Sem acesso à pasta «Aplicações» e à sua pasta pessoal, as funções «Limpar», «Otimizar» e «Desinstalar» ficam bloqueadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr poate citi și șterge doar în aceste dosare. Fără acces la Aplicații și la dosarul personal, Curățare, Optimizare și Dezinstalare sunt blocate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr môže čítať a mazať len v týchto priečinkoch. Bez prístupu k Aplikáciám a domovskému priečinku sú Upratanie, Optimalizácia a Odinštalovanie uzamknuté."
          }
        }
      }
    },
    "Swabr möchte Wartungsaufgaben ausführen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr chce spustit úlohy údržby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr möchte Wartungsaufgaben ausführen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr θέλει να εκτελέσει εργασίες συντήρησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr wants to run maintenance tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr quiere ejecutar tareas de mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr souhaite exécuter des tâches de maintenance."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr želi pokrenuti zadatke održavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr karbantartási feladatokat szeretne futtatni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr vuole eseguire operazioni di manutenzione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr pretende executar tarefas de manutenção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr dorește să ruleze sarcini de întreținere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr chce spustiť úlohy údržby."
          }
        }
      }
    },
    "Swabr neu starten, wenn macOS darum bittet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Restartujte aplikaci Swabr, když vás o to macOS požádá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr neu starten, wenn macOS darum bittet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επανεκκινήστε το Swabr όταν σας το ζητήσει το macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Swabr when macOS asks you to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Swabr cuando macOS te lo pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez Swabr lorsque macOS vous y invite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno pokrenite Swabr kada vas macOS to zatraži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítsa újra a Swabr alkalmazást, amikor a macOS erre kéri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia Swabr quando macOS te lo chiede."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Swabr quando o macOS lhe pedir para o fazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporniți Swabr când macOS vă solicită acest lucru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reštartujte aplikáciu Swabr, keď vás o to macOS požiada."
          }
        }
      }
    },
    "Swabr sucht in Caches, Build-Ordnern, Installern und Universal-Apps. Gelöscht wird erst, nachdem du die Liste geprüft hast.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr prohledává mezipaměti, složky s kompilacemi, instalační soubory a univerzální aplikace. Nic se neodstraní, dokud si seznam neprohlédnete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr sucht in Caches, Build-Ordnern, Installern und Universal-Apps. Gelöscht wird erst, nachdem du die Liste geprüft hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr αναζητά προσωρινά αρχεία, φακέλους κατασκευής, προγράμματα εγκατάστασης και εφαρμογές γενικής χρήσης. Τίποτα δεν διαγράφεται μέχρι να ελέγξετε τη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr searches caches, build folders, installers and universal apps. Nothing is deleted until you have reviewed the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr busca en cachés, carpetas de compilación, instaladores y aplicaciones universales. No se borra nada hasta que hayas revisado la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr analyse les caches, les dossiers de compilation, les programmes d'installation et les applications universelles. Rien n'est supprimé tant que vous n'avez pas vérifié la liste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr pretražuje kešove, mape za izgradnju, instalacijske programe i univerzalne aplikacije. Ništa se ne briše dok ne pregledate popis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr átkutatja a gyorsítótárakat, a build mappákat, a telepítőfájlokat és az univerzális alkalmazásokat. Semmi sem kerül törlésre, amíg át nem nézte a listát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr cerca nelle cache, nelle cartelle di compilazione, nei programmi di installazione e nelle app universali. Nulla viene eliminato finché non hai controllato l'elenco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr pesquisa caches, pastas de compilação, instaladores e aplicações universais. Nada é eliminado até que tenha revisto a lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr caută în cache-uri, foldere de compilare, instalatori și aplicații universale. Nimic nu este șters până când nu verificați lista."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia Swabr prehľadáva vyrovnávaciu pamäť, zložky so zostavami, inštalačné súbory a univerzálne aplikácie. Nič sa neodstráni, kým si zoznam nepreveríte."
          }
        }
      }
    },
