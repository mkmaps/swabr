    "Alle angehakten Einträge mit ihren Orten: genau das, was gelöscht wird": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny zaškrtnuté položky s jejich umístěním: přesně to, co bude smazáno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle angehakten Einträge mit ihren Orten: genau das, was gelöscht wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι επιλεγμένες καταχωρήσεις με τις αντίστοιχες θέσεις τους: ακριβώς τι θα διαγραφεί"
