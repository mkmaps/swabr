    "Ausgeschaltet (Standard) bleiben Einstellungen, Konten und Daten erhalten, falls du die App später neu installierst. Browser-Profile und App-Gruppen-Daten werden nie automatisch ausgewählt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto (výchozí): nastavení, účty a data zůstanou zachována pro případ opětovné instalace. Profily prohlížečů a data skupin aplikací se nikdy nevybírají automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet (Standard) bleiben Einstellungen, Konten und Daten erhalten, falls du die App später neu installierst. Browser-Profile und App-Gruppen-Daten werden nie automatisch ausgewählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανενεργό (προεπιλογή): ρυθμίσεις, λογαριασμοί και δεδομένα διατηρούνται σε περίπτωση που εγκαταστήσετε ξανά την εφαρμογή. Προφίλ προγραμμάτων περιήγησης και δεδομένα ομάδων εφαρμογών δεν επιλέγονται ποτέ αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off (default): settings, accounts and data are kept in case you reinstall the app later. Browser profiles and app group data are never selected automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado (por defecto): se conservan los ajustes, las cuentas y los datos por si reinstalas la app más adelante. Los perfiles del navegador y los datos de los grupos de apps nunca se seleccionan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé (par défaut) : les paramètres, les comptes et les données sont conservés au cas où vous réinstalleriez l’application ultérieurement. Les profils de navigateur et les données des groupes d’applications ne sont jamais sélectionnés automatiquement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno (zadano): postavke, računi i podaci se zadržavaju u slučaju da kasnije ponovno instalirate aplikaciju. Profili preglednika i podaci grupa aplikacija nikad se ne odabiru automatski."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva (alapértelmezés): a beállítások, fiókok és adatok megmaradnak, ha később újratelepíti az appot. A böngészőprofilok és appcsoport-adatok soha nincsenek automatikusan kijelölve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato (impostazione predefinita): le impostazioni, gli account e i dati vengono conservati nel caso in cui reinstalli l’app in un secondo momento. I profili del browser e i dati dei gruppi di app non vengono mai selezionati automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado (predefinição): as definições, contas e dados são mantidos, caso volte a instalar a aplicação posteriormente. Os perfis do navegador e os dados dos grupos de aplicações nunca são selecionados automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat (implicit): setările, conturile și datele sunt păstrate în cazul în care reinstalați aplicația. Profilurile de browser și datele grupurilor de aplicații nu sunt niciodată selectate automat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuté (predvolené): nastavenia, účty a údaje zostanú zachované pre prípad opätovnej inštalácie. Profily prehliadačov a údaje skupín aplikácií sa nikdy nevyberajú automaticky."
          }
        }
      }
    },
    "Ausgeschaltet wird sofort entfernt. Laufende Apps fragen weiterhin nach, bevor sie beendet werden. Alles landet im Papierkorb.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je vypnuto, odstraní se hned. Spuštěné aplikace se před ukončením stále potvrzují. Vše skončí v Koši."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet wird sofort entfernt. Laufende Apps fragen weiterhin nach, bevor sie beendet werden. Alles landet im Papierkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι απενεργοποιημένο, η αφαίρεση γίνεται αμέσως. Οι εφαρμογές σε εκτέλεση ζητούν πάντα επιβεβαίωση πριν τερματιστούν. Όλα πηγαίνουν στον Κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, apps are removed right away. Running apps are still confirmed before they are quit. Everything goes to the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, se eliminan al instante. Las apps abiertas siguen pidiendo confirmación antes de cerrarse. Todo va a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, la suppression est immédiate. Les apps ouvertes demandent toujours une confirmation avant d'être fermées. Tout va dans la Corbeille."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je isključeno, uklanja se odmah. Pokrenute aplikacije i dalje traže potvrdu prije zatvaranja. Sve završava u Smeću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva azonnal eltávolítja. A futó appok bezárása előtt továbbra is megerősítést kér. Minden a Kukába kerül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, la rimozione è immediata. Le app in esecuzione chiedono comunque conferma prima di essere chiuse. Tutto finisce nel Cestino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, a remoção é imediata. As apps em execução continuam a pedir confirmação antes de serem encerradas. Tudo vai para o Lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat, eliminarea are loc imediat. Aplicațiile care rulează cer în continuare confirmare înainte de a fi închise. Totul ajunge în Coș."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je vypnuté, odstráni sa hneď. Spustené aplikácie sa pred ukončením stále potvrdzujú. Všetko skončí v Koši."
          }
        }
      }
    },
