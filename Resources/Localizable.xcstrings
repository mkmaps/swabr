    "Hier erscheint jede Löschung, jedes Verschieben in den Papierkorb und jede verschlankte App.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se objeví každé smazání, každý přesun do Koše a každá zeštíhlená aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheint jede Löschung, jedes Verschieben in den Papierkorb und jede verschlankte App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ εμφανίζεται κάθε διαγραφή, κάθε μετακίνηση στον Κάδο και κάθε εφαρμογή που ελαφρύνθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every deletion, every move to the Trash and every slimmed app appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparece cada eliminación, cada traslado a la Papelera y cada aplicación que has optimizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque suppression, chaque placement dans la Corbeille et chaque application allégée apparaissent ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se pojavljuje svako brisanje, svako premještanje u Smeće i svaka smanjena aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelenik meg minden törlés, minden Kukába helyezés és minden karcsúsított app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compaiono ogni eliminazione, ogni spostamento nel Cestino e ogni app alleggerita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada eliminação, cada movimento para o Lixo e cada aplicação otimizada aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici apare fiecare ștergere, fiecare mutare în Coș și fiecare aplicație redusă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa objaví každé zmazanie, každý presun do Koša a každá zoštíhlená aplikácia."
          }
        }
      }
    },
