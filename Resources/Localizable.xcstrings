    "Optional: einmal erlauben, dann fragt macOS nicht mehr": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné: povolte to jednou a macOS se již nebude ptát"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: einmal erlauben, dann fragt macOS nicht mehr"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό: επιτρέψτε το μία φορά και το macOS θα σταματήσει να ρωτάει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: allow it once, then macOS stops asking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: permítelo una vez y macOS dejará de preguntártelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : autorisez-le une seule fois, puis macOS cessera de vous le demander"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalno: dopustite jednom, a macOS prestaje tražiti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális: engedélyezze egyszer, és a macOS többé nem fogja kérdezni"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzionale: autorizzalo una volta sola, poi macOS smetterà di chiedertelo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: autorize uma vez e o macOS deixará de perguntar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional: permiteți o singură dată, iar apoi macOS nu va mai solicita permisiunea"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné: povoliť to raz, potom sa macOS prestane pýtať"
          }
        }
      }
    },
