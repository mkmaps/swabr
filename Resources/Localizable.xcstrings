    "Welche Apps beim Anmelden starten, stellst du in den Systemeinstellungen ein. Swabr zeigt hier die Hintergrunddienste in deinem Benutzerordner.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Které aplikace se spouštějí při přihlášení, nastavíte v Nastavení systému. Swabr zde ukazuje služby na pozadí ve vaší domovské složce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Apps beim Anmelden starten, stellst du in den Systemeinstellungen ein. Swabr zeigt hier die Hintergrunddienste in deinem Benutzerordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζετε ποιες εφαρμογές ανοίγουν κατά τη σύνδεση στις Ρυθμίσεις συστήματος. Το Swabr εμφανίζει εδώ τις υπηρεσίες παρασκηνίου στον προσωπικό σας φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You set which apps open at login in System Settings. Swabr shows the background services in your home folder here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes configurar qué aplicaciones se abren al iniciar sesión en «Ajustes del Sistema». Swabr muestra aquí los servicios en segundo plano de tu carpeta de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous définissez les applications qui s'ouvrent à la connexion dans les Réglages Système. Swabr affiche ici les services s'exécutant en arrière-plan dans votre dossier d'accueil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koje se aplikacije otvaraju pri prijavi postavljate u Postavkama sustava. Swabr ovdje prikazuje pozadinske usluge u vašoj kućnoj mapi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy mely appok induljanak bejelentkezéskor, azt a Rendszerbeállításokban adhatja meg. A Swabr itt a saját mappájában lévő háttérszolgáltatásokat mutatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi impostare quali app apri al login nelle Impostazioni di Sistema. Swabr mostra qui i servizi in background presenti nella tua cartella Home."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode definir quais as aplicações que se abrem ao iniciar sessão nas «Definições do Sistema». O Swabr apresenta aqui os serviços em segundo plano na sua pasta pessoal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabiliți ce aplicații se deschid la autentificare în Configurări sistem. Swabr afișează aici serviciile de fundal din dosarul dvs. personal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoré aplikácie sa spúšťajú pri prihlásení, nastavíte v Nastaveniach systému. Swabr tu ukazuje služby na pozadí vo vašom domovskom priečinku."
          }
        }
      }
    },
