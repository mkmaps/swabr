    "Änderungen werden sofort gespeichert. Zusätzlich gelten immer die Sicherheitsregeln unten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se ukládají okamžitě. Navíc vždy platí bezpečnostní pravidla níže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden sofort gespeichert. Zusätzlich gelten immer die Sicherheitsregeln unten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές αποθηκεύονται αμέσως. Οι παρακάτω κανόνες ασφαλείας ισχύουν πάντα επιπλέον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are saved immediately. The safety rules below always apply as well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan al instante. Además, siempre se aplican las normas de seguridad que aparecen a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont enregistrées immédiatement. Les règles de sécurité ci-dessous s’appliquent également dans tous les cas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene se odmah spremaju. Sigurnosna pravila ispod uvijek dodatno vrijede."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítások azonnal mentődnek. Emellett mindig érvényesek az alábbi biztonsági szabályok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche vengono salvate immediatamente. Si applicano sempre anche le regole di sicurezza riportate di seguito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são guardadas imediatamente. As regras de segurança abaixo aplicam-se sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările sunt salvate imediat. Regulile de siguranță de mai jos se aplică mereu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny sa ukladajú okamžite. Navyše vždy platia bezpečnostné pravidlá nižšie."
          }
        }
      }
    },
