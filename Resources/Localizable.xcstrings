    "%lld Elemente endgültig gelöscht. Jede Löschung steht im Verlauf.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld položek bylo trvale odstraněno. Každé odstranění je uvedeno v historii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Elemente endgültig gelöscht. Jede Löschung steht im Verlauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld στοιχεία διαγράφηκαν οριστικά. Κάθε διαγραφή καταγράφεται στο Ιστορικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items permanently deleted. Every deletion is listed in History."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos eliminados definitivamente. Cada eliminación aparece en el Historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments supprimés définitivement. Chaque suppression est répertoriée dans l'historique."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%llda stavki trajno izbrisano. Svako brisanje je navedeno u Povijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elem véglegesen törölve. Minden törlés felkerül a Történetbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementi eliminati definitivamente. Ogni eliminazione viene registrata nella Cronologia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld itens eliminados definitivamente. Cada eliminação é registada no Histórico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de elemente șterse definitiv. Fiecare ștergere este înregistrată în Istoric."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld položiek bolo natrvalo odstránených. Každé odstránenie je zaznamenané v histórii."
          }
        }
      }
    },
    "%lld Elemente liegen im Papierkorb. Du kannst alles bis zum Leeren zurückholen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V koši je %lld položek. Vše můžete vrátit zpět, dokud koš nevyprázdníte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Elemente liegen im Papierkorb. Du kannst alles bis zum Leeren zurückholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld στοιχεία βρίσκονται στον Κάδο απορριμμάτων. Μπορείτε να τα επαναφέρετε όλα μέχρι να αδειάσετε τον Κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items are in the Trash. You can put everything back until you empty it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld elementos en la Papelera. Puedes recuperarlo todo hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments se trouvent dans la Corbeille. Vous pouvez tout récupérer tant que vous ne l'avez pas vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%llda stavke su u Kanti za smeće. Možete vratiti sve dok ne ispraznite kantu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elem található a Kuka-ban. Mindent visszahelyezhet, amíg ki nem üríti a Kuka-t."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono %lld elementi nel Cestino. Puoi ripristinarli tutti finché non lo svuoti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem %lld itens no Lixo. Pode recuperar tudo até o esvaziar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de elemente se află în Coșul de gunoi. Puteți restabili totul până când îl goliți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V koši sa nachádza %lld položiek. Všetko môžete vrátiť späť, kým koš nevyprázdnite."
          }
        }
      }
    },
