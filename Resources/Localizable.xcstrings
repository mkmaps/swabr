    "Gesucht wird nach node_modules, target, build, dist, .venv, Pods und 28 weiteren Arten, bis 6 Ebenen tief.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledá node_modules, target, build, dist, .venv, Pods a 28 dalších druhů, až 6 úrovní hluboko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesucht wird nach node_modules, target, build, dist, .venv, Pods und 28 weiteren Arten, bis 6 Ebenen tief."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητά node_modules, target, build, dist, .venv, Pods και 28 ακόμη είδη, έως 6 επίπεδα σε βάθος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches for node_modules, target, build, dist, .venv, Pods and 28 more kinds, up to 6 levels deep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en carpetas como node_modules, target, build, dist, .venv, Pods y otros 28 tipos más, hasta 6 niveles de profundidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les dossiers « node_modules », « target », « build », « dist », « .venv », « Pods » et 28 autres types de dossiers, jusqu’à 6 niveaux de profondeur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traži node_modules, target, build, dist, .venv, Pods i još 28 vrsta, do 6 razina dubine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresés: node_modules, target, build, dist, .venv, Pods és még 28 típus, legfeljebb 6 szint mélyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca file in directory come node_modules, target, build, dist, .venv, Pods e altre 28 tipologie, fino a 6 livelli di profondità."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura por «node_modules», «target», «build», «dist», «.venv», «Pods» e mais 28 tipos, até 6 níveis de profundidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
