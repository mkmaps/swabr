    "Entfernt den Intel-Code aus %lld Dateien. Die App läuft danach nur noch auf Apple-Silicon-Macs, nicht mehr mit Rosetta oder auf Intel-Macs.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní kód Intel z %lld souborů. Aplikace pak poběží jen na Macích s Apple silicon, ne s Rosettou ani na Macích s Intelem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den Intel-Code aus %lld Dateien. Die App läuft danach nur noch auf Apple-Silicon-Macs, nicht mehr mit Rosetta oder auf Intel-Macs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί τον κώδικα Intel από %lld αρχεία. Η εφαρμογή θα εκτελείται μόνο σε Mac με Apple silicon, όχι πλέον με Rosetta ή σε Mac με Intel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the Intel code from %lld files. The app then runs only on Apple silicon Macs, no longer with Rosetta or on Intel Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el código Intel de los archivos %lld. Así, la app solo funciona en Macs con Apple Silicon, ya no con Rosetta ni en Macs con Intel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le code Intel des fichiers %lld. L’application ne fonctionne alors plus que sur les Mac équipés d’Apple Silicon, ni avec Rosetta ni sur les Mac Intel."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja Intel kod iz %lld datoteka. Aplikacija tada radi samo na Macovima s Apple siliconom, više ne s Rosettom ni na Intel Macovima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja az Intel-kódot %lld fájlból. Az app ezután csak Apple silicon alapú Maceken fut, Rosettával vagy Intel-alapú Maceken már nem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il codice Intel dai file %lld. L’app funziona quindi solo sui Mac con Apple Silicon, non più con Rosetta né sui Mac Intel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o código Intel dos ficheiros %lld. O aplicativo passa então a funcionar apenas em Macs com Apple Silicon, deixando de funcionar com o Rosetta ou em Macs com processadores Intel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină codul Intel din %lld fișiere. Aplicația rulează apoi doar pe Mac-uri cu Apple silicon, nu și cu Rosetta sau pe Mac-uri cu Intel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni kód Intel z %lld súborov. Aplikácia potom pobeží len na Macoch s Apple silicon, nie s Rosettou ani na Macoch s Intelom."
          }
        }
      }
    },
