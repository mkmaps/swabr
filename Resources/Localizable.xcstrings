    "%lld Aufgaben brauchen Administratorrechte: Das Passwort wird einmal für alle abgefragt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld úloh potřebuje administrátorská práva: heslo se zadá jednou pro všechny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Aufgaben brauchen Administratorrechte: Das Passwort wird einmal für alle abgefragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld εργασίες χρειάζονται δικαιώματα διαχειριστή: το συνθηματικό ζητείται μία φορά για όλες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tasks need administrator rights: the password is asked once for all of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas %llds requieren derechos de administrador: te pedirán la contraseña una sola vez para todas ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tâches nécessitent des droits d'administrateur : le mot de passe n'est demandé qu'une seule fois pour l'ensemble de ces tâches."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld zadataka treba administratorska prava: lozinka se traži jednom za sve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld feladathoz rendszergazdai jog kell: a jelszót egyszer kéri mindegyikhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni %lld richiedono i diritti di amministratore: la password viene richiesta una sola volta per tutte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tarefas requerem direitos de administrador: a palavra-passe é solicitada uma única vez para todas elas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sarcini necesită drepturi de administrator: parola este cerută o singură dată pentru toate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld úloh potrebuje administrátorské práva: heslo sa zadá raz pre všetky."
          }
        }
      }
    },
