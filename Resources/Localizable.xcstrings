    "Wartung für Finder, Netzwerk, Datenbanken und macOS-Dienste. Unnötige Schritte werden mit Begründung übersprungen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údržba Finderu, sítě, databází a služeb macOS. Zbytečné kroky se přeskočí s odůvodněním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartung für Finder, Netzwerk, Datenbanken und macOS-Dienste. Unnötige Schritte werden mit Begründung übersprungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συντήρηση για Finder, δίκτυο, βάσεις δεδομένων και υπηρεσίες macOS. Τα περιττά βήματα παραλείπονται με αιτιολόγηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance for Finder, network, databases and macOS services. Unnecessary steps are skipped with a reason."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenimiento del Finder, la red, las bases de datos y los servicios de macOS. Se omiten los pasos innecesarios, explicando el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance du Finder, du réseau, des bases de données et des services macOS. Les étapes superflues sont omises, et ce pour une bonne raison."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Održavanje za Finder, mrežu, baze podataka i macOS usluge. Nepotrebni koraci preskaču se uz obrazloženje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Karbantartás a Finder, a hálózat, az adatbázisok és a macOS-szolgáltatások számára. A szükségtelen lépések indoklással kimaradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manutenzione del Finder, della rete, dei database e dei servizi di macOS. I passaggi non necessari vengono saltati, spiegandone il motivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manutenção do Finder, da rede, das bases de dados e dos serviços do macOS. Os passos desnecessários são omitidos, com justificação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreținere pentru Finder, rețea, baze de date și servicii macOS. Pașii inutili sunt omiși cu o justificare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údržba Findera, siete, databáz a služieb macOS. Zbytočné kroky sa preskočia s odôvodnením."
          }
        }
      }
    },
