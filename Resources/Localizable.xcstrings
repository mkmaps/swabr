    "Geschützt bleiben: laufende Apps, deine Ausnahmen und alles unter /System.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy chráněno: spuštěné aplikace, vaše výjimky a vše v adresáři /System."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützt bleiben: laufende Apps, deine Ausnahmen und alles unter /System."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάντα προστατευμένα: οι εφαρμογές που εκτελούνται, οι εξαιρέσεις σας και όλα τα στοιχεία στο φάκελο /System."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always protected: running apps, your exceptions and everything in /System."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre protegido: las apps en ejecución, tus excepciones y todo lo que hay en /System."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours protégés : les applications en cours d'exécution, vos exceptions et tout ce qui se trouve dans /System."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvijek zaštićeno: pokrenute aplikacije, vaše iznimke i sve u /System."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindig védett: a futó alkalmazások, a kivételek és a /System mappában található összes elem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre protetti: le app in esecuzione, le tue eccezioni e tutto ciò che si trova nella cartella /System."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre protegido: aplicações em execução, as suas exceções e tudo o que se encontra na pasta /System."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întotdeauna protejate: aplicațiile care rulează, excepțiile dvs. și tot ce se află în /System."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy chránené: spustené aplikácie, vaše výnimky a všetko v priečinku /System."
          }
        }
      }
    },
