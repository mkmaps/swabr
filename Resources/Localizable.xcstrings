    "Wähle die Ordner, deren Speicherbelegung du sehen möchtest. Swabr merkt sich den Zugriff.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte složky, jejichž využití úložiště chcete vidět. Swabr si přístup zapamatuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Ordner, deren Speicherbelegung du sehen möchtest. Swabr merkt sich den Zugriff."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τους φακέλους των οποίων τη χρήση χώρου θέλετε να δείτε. Το Swabr θυμάται την πρόσβαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folders whose storage usage you want to see. Swabr remembers the access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las carpetas cuyo uso de almacenamiento quieras ver. Swabr recuerda tu selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les dossiers dont vous souhaitez consulter l'utilisation de l'espace de stockage. Swabr mémorise votre sélection."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite mape čije zauzeće prostora želite vidjeti. Swabr pamti pristup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki azokat a mappákat, amelyek tárhelyhasználatát látni szeretné. A Swabr megjegyzi a hozzáférést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le cartelle di cui vuoi vedere l’utilizzo dello spazio di archiviazione. Swabr ricorda le tue scelte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as pastas cujo uso de armazenamento pretende ver. O Swabr guarda essa informação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți dosarele a căror utilizare a spațiului doriți să o vedeți. Swabr reține accesul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte priečinky, ktorých využitie úložiska chcete vidieť. Swabr si prístup zapamätá."
          }
        }
      }
    },
    "Wähle links eine App, um ihre Dateien zu sehen.": {
