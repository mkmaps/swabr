        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törlődik, de bármikor újra létrehozható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminato definitivamente, ma può essere ricreato in qualsiasi momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado definitivamente, mas pode ser recriado a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șters definitiv, dar poate fi recreat oricând."
