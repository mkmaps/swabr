    "Auf das Zahnrad klicken. Es öffnet sich Datenschutz & Sicherheit → Festplattenvollzugriff.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na ozubené kolečko. Otevře se okno Soukromí a zabezpečení → Plný přístup k disku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf das Zahnrad klicken. Es öffnet sich Datenschutz & Sicherheit → Festplattenvollzugriff."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο γρανάζι. Ανοίγει η επιλογή «Απόρρητο και ασφάλεια» → «Πλήρης πρόσβαση στον δίσκο»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the gear. Privacy & Security → Full Disk Access opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de engranaje. Se abrirá «Privacidad y seguridad» → «Acceso total al disco»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l'icône en forme d'engrenage. La fenêtre « Confidentialité et sécurité → Accès complet au disque » s'ouvre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na zupčanik. Privatnost i sigurnost → Potpuni pristup disku se otvara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a fogaskerékre. Megnyílik az Adatvédelem és biztonság → Teljes lemezhozzáférés menü."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca sull’icona a forma di ingranaggio. Si aprirà Privacy e sicurezza → Accesso completo al disco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na engrenagem. Abre-se «Privacidade e segurança» → «Acesso total ao disco»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe rotița de setări. Se deschide fereastra Confidențialitate și securitate → Acces complet la disc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na ozubené koliesko. Otvorí sa okno Súkromie a bezpečnosť → Úplný prístup k disku."
          }
        }
      }
    },
    "Auf einem Intel-Mac wird der Intel-Code gebraucht.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac s procesorem Intel kód Intel potřebuje."
          }
        },
