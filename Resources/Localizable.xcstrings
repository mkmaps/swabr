    "%@ in Caches, Build-Ordnern und Installer-Resten gefunden. Gelöscht wird erst, nachdem du die Liste geprüft hast.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nalezeno v mezipamětech, složkách sestavení a zbytcích instalačních programů. Dokud seznam nezkontrolujete, nic se neodstraní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in Caches, Build-Ordnern und Installer-Resten gefunden. Gelöscht wird erst, nachdem du die Liste geprüft hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ που βρέθηκαν σε προσωρινές μνήμες, φακέλους κατασκευής και υπολείμματα προγραμμάτων εγκατάστασης. Τίποτα δεν διαγράφεται μέχρι να ελέγξετε τη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ found in caches, build folders and leftover installers. Nothing is deleted until you have reviewed the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encontrado en cachés, carpetas de compilación e instaladores que han quedado sin usar. No se borra nada hasta que hayas revisado la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trouvé dans les caches, les dossiers de compilation et les résidus d'installateurs. Rien n'est supprimé tant que vous n'avez pas vérifié la liste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pronađen u predmemorijama, mapama za izgradnju i preostalim instalaterima. Ništa se ne briše dok ne pregledate popis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a gyorsítótárakban, a build mappákban és a maradék telepítőfájlokban található. Semmi sem kerül törlésre, amíg át nem nézte a listát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trovato nelle cache, nelle cartelle di compilazione e nei file residui dei programmi di installazione. Nulla viene eliminato finché non avrai controllato l'elenco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encontrado em caches, pastas de compilação e instaladores remanescentes. Nada é eliminado até que tenha revisto a lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ găsite în cache-uri, foldere de compilare și fișiere de instalare rămase. Nimic nu este șters până când nu verificați lista."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nájdené v cache, zložkách zostavenia a zvyškoch inštalačných súborov. Nič sa neodstráni, kým si zoznam nepreveríte."
          }
        }
      }
    },
    "%@ ließ sich nicht beenden. Bitte selbst beenden und erneut versuchen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nelze ukončit. Ukončete ji prosím sami a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ließ sich nicht beenden. Bitte selbst beenden und erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό να τερματιστεί η εφαρμογή %@. Τερματίστε την μόνοι σας και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be quit. Please quit it yourself and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cerrar %@. Cierra la aplicación tú mismo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas pu être fermé. Veuillez le fermer vous-même et réessayer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %@ nije se mogla zatvoriti. Zatvorite je sami i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem zárható be. Zárja be saját maga, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile chiudere %@. Chiudilo manualmente e riprova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encerrar o %@. Por favor, encerre-o manualmente e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu a putut fi închisă. Închideți-o manual și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sa nedá ukončiť. Ukončite ju sami a skúste to znova."
          }
        }
      }
    },
