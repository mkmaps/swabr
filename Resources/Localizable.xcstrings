    "Erscheinen nur, solange das Recht fehlt. Jeder Hinweis lässt sich auch direkt im Fenster abschalten.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazují se pouze v případě, že chybí příslušné právo. Každé upozornění lze také vypnout v samostatném okně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinen nur, solange das Recht fehlt. Jeder Hinweis lässt sich auch direkt im Fenster abschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται μόνο όταν υπάρχει κάποια έλλειψη. Κάθε ειδοποίηση μπορεί επίσης να απενεργοποιηθεί στο δικό της παράθυρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only appear while the right is missing. Each notice can also be switched off in its own window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aparecen cuando falta el derecho. Cada aviso también se puede desactivar en su propia ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces messages n’apparaissent que lorsque l’élément correspondant est manquant. Chaque notification peut également être désactivée dans sa propre fenêtre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojavljuju se samo kad je potrebno. Svaku obavijest također je moguće isključiti u vlastitom prozoru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor jelennek meg, ha a megfelelő elem hiányzik. Minden értesítés a saját ablakában is kikapcsolható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appaiono solo quando manca l’elemento corrispondente. Ogni avviso può anche essere disattivato nella propria finestra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas aparecem enquanto a informação à direita estiver em falta. Cada aviso pode também ser desativado na sua própria janela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apar doar atunci când dreptul lipsește. Fiecare notificare poate fi dezactivată și în fereastra proprie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazujú sa len v prípade, ak chýba príslušná funkcia. Každé upozornenie je možné vypnúť aj v samostatnom okne."
          }
        }
      }
    },
