    "Auch Einträge der Stufe „Prüfen“ vorauswählen": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předvybrat i položky úrovně „Zkontrolovat“"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Einträge der Stufe „Prüfen“ vorauswählen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προεπιλογή και των καταχωρίσεων με αξιολόγηση «Έλεγχος»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also preselect entries rated “Review”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además, preselecciona las entradas con la calificación «Revisar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez également les entrées classées « À vérifier »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaprijed odaberi i unose ocijenjene „Provjerite”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az „Ellenőrizendő” szintű bejegyzések előzetes kijelölése is"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoltre, preseleziona le voci contrassegnate come “Da rivedere”"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione também previamente as entradas classificadas como «Revisão»"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Preselectați și intrările de nivel „Verificați”"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvybrať aj položky úrovne „Skontrolovať“"
          }
        }
      }
    },
