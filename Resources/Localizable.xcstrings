        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limba se schimbă la următoarea pornire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk sa zmení pri ďalšom spustení."
          }
        }
      }
    },
    "Diese App meldet sich selbst an. Ein- und ausschalten lässt sie sich in den Systemeinstellungen oder in der App.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato aplikace se přihlašuje sama. Zapnout a vypnout ji lze v Nastavení systému nebo v aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App meldet sich selbst an. Ein- und ausschalten lässt sie sich in den Systemeinstellungen oder in der App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εφαρμογή καταχωρίζεται μόνη της. Μπορείτε να την ενεργοποιήσετε και να την απενεργοποιήσετε στις Ρυθμίσεις συστήματος ή στην εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app registers itself. You can switch it on and off in System Settings or in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app se registra sola. Puedes activarla y desactivarla en Ajustes del Sistema o en la propia app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app s’ajoute elle-même. Vous pouvez l’activer ou la désactiver dans Réglages Système ou dans l’app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova se aplikacija sama prijavljuje. Uključiti i isključiti je možete u Postavkama sustava ili u aplikaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az app saját magát regisztrálja. A Rendszerbeállításokban vagy magában az appban kapcsolhatja be és ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app si registra da sola. Puoi attivarla e disattivarla in Impostazioni di Sistema o nell’app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app regista-se sozinha. Pode ativá-la e desativá-la nas Definições do Sistema ou na própria app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această aplicație se înregistrează singură. O puteți activa și dezactiva în Configurări sistem sau în aplicație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto aplikácia sa prihlasuje sama. Zapnúť a vypnúť ju môžete v Nastaveniach systému alebo v aplikácii."
          }
        }
      }
    },
    "Diese Daten löscht Swabr nicht automatisch: ob sie weg können, entscheidest du in der jeweiligen App.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato data Swabr automaticky nemaže: o jejich odstranění rozhodnete v příslušné aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten löscht Swabr nicht automatisch: ob sie weg können, entscheidest du in der jeweiligen App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr δεν διαγράφει αυτά τα δεδομένα αυτόματα: αποφασίζετε στην αντίστοιχη εφαρμογή αν μπορούν να φύγουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr doesn't delete this data automatically: you decide in the respective app whether it can go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr no borra estos datos automáticamente: tú decides en la aplicación correspondiente si se pueden eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr ne supprime pas automatiquement ces données : c’est vous qui décidez, dans l’application concernée, si elles peuvent être supprimées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr ne briše te podatke automatski: vi odlučujete u dotičnoj aplikaciji smiju li se ukloniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket az adatokat a Swabr nem törli automatikusan: az adott appban dönti el, eltávolíthatók-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr non elimina automaticamente questi dati: sei tu a decidere, all’interno della rispettiva app, se possono essere rimossi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr não elimina estes dados automaticamente: é o utilizador que decide, na respetiva aplicação, se estes podem ser eliminados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nu șterge automat aceste date: decideți în aplicația respectivă dacă pot fi eliminate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto údaje Swabr automaticky nemaže: o ich odstránení rozhodnete v príslušnej aplikácii."
          }
        }
      }
    },
    "Diese Einträge verweisen auf Programme, die nicht mehr installiert sind: %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto položky odkazují na programy, které už nejsou nainstalovány: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einträge verweisen auf Programme, die nicht mehr installiert sind: %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές οι καταχωρίσεις δείχνουν σε προγράμματα που δεν είναι πλέον εγκατεστημένα: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These entries point to programs that are no longer installed: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas entradas hacen referencia a programas que ya no están instalados: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces entrées renvoient à des programmes qui ne sont plus installés : %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovi unosi upućuju na programe koji više nisu instalirani: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a bejegyzések már nem telepített programokra mutatnak: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste voci indicano programmi che non sono più installati: %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas entradas referem-se a programas que já não estão instalados: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste intrări indică programe care nu mai sunt instalate: %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto položky odkazujú na programy, ktoré už nie sú nainštalované: %@."
          }
        }
      }
    },
    "Diese Orte hat der Scan gefunden, Swabr lässt sie aber stehen: laufende Apps, deine Ausnahmen und geschützte Bereiche.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenování našlo tato místa, ale Swabr je nechává na pokoji: spuštěné aplikace, vaše výjimky a chráněné oblasti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Orte hat der Scan gefunden, Swabr lässt sie aber stehen: laufende Apps, deine Ausnahmen und geschützte Bereiche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση εντόπισε αυτές τις τοποθεσίες, αλλά το Swabr δεν τις αγγίζει: εφαρμογές που εκτελούνται, τις εξαιρέσεις σας και τις προστατευμένες περιοχές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan found these locations, but Swabr leaves them alone: running apps, your exceptions and protected areas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis ha detectado estas ubicaciones, pero Swabr no las toca: aplicaciones en ejecución, tus excepciones y áreas protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse a détecté ces emplacements, mais Swabr ne les modifie pas : les applications en cours d'exécution, vos exceptions et les zones protégées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skener je pronašao ove lokacije, ali Swabr ih ne dira: pokrenute aplikacije, vaše iznimke i zaštićena područja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vizsgálat ezeket a helyeket találta meg, de a Swabr nem nyúl hozzájuk: a futó alkalmazásokhoz, a kivételekhez és a védett területekhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione ha individuato queste posizioni, ma Swabr le lascia stare: le app in esecuzione, le tue eccezioni e le aree protette."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise detetou estas localizações, mas o Swabr não as altera: aplicações em execução, as suas exceções e áreas protegidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanarea a identificat aceste locații, dar Swabr nu le afectează: aplicațiile care rulează, excepțiile dvs. și zonele protejate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenovanie našlo tieto miesta, ale Swabr ich necháva na pokoji: spustené aplikácie, vaše výnimky a chránené oblasti."
          }
        }
      }
    },
