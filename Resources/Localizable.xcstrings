    "Swabr braucht die Erlaubnis, „System Events“ zu steuern, um die Anmeldeobjekte zu lesen und zu ändern.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr potřebuje oprávnění ovládat „System Events“, aby mohl číst a měnit položky přihlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr braucht die Erlaubnis, „System Events“ zu steuern, um die Anmeldeobjekte zu lesen und zu ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr χρειάζεται άδεια για να ελέγχει το «System Events» ώστε να διαβάζει και να αλλάζει τα στοιχεία σύνδεσής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr needs permission to control “System Events” to read and change your login items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr necesita permiso para controlar «Eventos del sistema» y así poder leer y modificar tus ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr a besoin d’une autorisation pour contrôler les « Événements système » afin de lire et de modifier vos ouvertures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr treba dozvolu za upravljanje „System Events” kako bi čitao i mijenjao vaše stavke prijave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr-nek engedély kell a „System Events” vezérléséhez a bejelentkezési elemek olvasásához és módosításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr ha bisogno dell’autorizzazione per controllare gli “Eventi di sistema” per leggere e modificare i tuoi Elementi login."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr necessita de autorização para controlar os «Eventos do Sistema», a fim de ler e alterar os seus elementos de início de sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr are nevoie de permisiunea de a controla „System Events” pentru a citi și modifica articolele de autentificare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr potrebuje oprávnenie ovládať „System Events“, aby mohol čítať a meniť položky prihlásenia."
          }
        }
      }
    },
    "Swabr darf System Events nicht steuern. Bitte unter Systemeinstellungen → Datenschutz & Sicherheit → Automation erlauben.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nesmí ovládat System Events. Povolte to v Nastavení systému → Soukromí a zabezpečení → Automatizace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr darf System Events nicht steuern. Bitte unter Systemeinstellungen → Datenschutz & Sicherheit → Automation erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Swabr δεν επιτρέπεται να ελέγχει το System Events. Επιτρέψτε το στις Ρυθμίσεις συστήματος → Απόρρητο και ασφάλεια → Αυτοματισμός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr isn't allowed to control System Events. Please allow it in System Settings → Privacy & Security → Automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr no tiene permiso para controlar System Events. Permítelo en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr n’est pas autorisé à contrôler System Events. Autorisez-le dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr ne smije upravljati System Events. Dopustite to u Postavkama sustava → Privatnost i sigurnost → Automatizacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Swabr nem vezérelheti a System Eventst. Engedélyezze a Rendszerbeállítások → Adatvédelem és biztonság → Automatizálás alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr non è autorizzato a controllare System Events. Consentilo in Impostazioni di Sistema → Privacy e sicurezza → Automazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Swabr não tem permissão para controlar o System Events. Autorize-o em Definições do Sistema → Privacidade e segurança → Automatização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nu are voie să controleze System Events. Permiteți acest lucru în Configurări sistem → Confidențialitate și securitate → Automatizare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swabr nesmie ovládať System Events. Povoľte to v Nastaveniach systému → Súkromie a bezpečnosť → Automatizácia."
          }
        }
      }
    },
