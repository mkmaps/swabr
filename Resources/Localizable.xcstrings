    "Gehört einem anderen Benutzer oder dem System: Löschen braucht dein Passwort": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Patří jinému uživateli nebo systému: smazání vyžaduje vaše heslo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehört einem anderen Benutzer oder dem System: Löschen braucht dein Passwort"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανήκει σε άλλον χρήστη ή στο σύστημα: η διαγραφή χρειάζεται το συνθηματικό σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owned by another user or the system: deleting needs your password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertenece a otro usuario o al sistema: para borrarlo necesitas tu contraseña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appartient à un autre utilisateur ou au système : la suppression nécessite votre mot de passe"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripada drugom korisniku ili sustavu: brisanje traži vašu lozinku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más felhasználóé vagy a rendszeré: a törléshez a jelszava kell"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di proprietà di un altro utente o del sistema: per eliminarlo serve la tua password"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertencente a outro utilizador ou ao sistema: a eliminação requer a sua palavra-passe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparține altui utilizator sau sistemului: ștergerea necesită parola dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrí inému používateľovi alebo systému: zmazanie vyžaduje vaše heslo"
          }
        }
      }
    },
    "Gehört „%@“: macOS fragt beim Löschen nach deinem Passwort.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Patří „%@“: macOS se při mazání zeptá na vaše heslo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehört „%@“: macOS fragt beim Löschen nach deinem Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανήκει στο «%@»: το macOS ζητά το συνθηματικό σας κατά τη διαγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owned by “%@”: macOS asks for your password when deleting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Propiedad de «%@»: macOS te pide la contraseña al borrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appartient à « %@ » : macOS vous demande votre mot de passe lors de la suppression."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripada „%@”: macOS pri brisanju traži vašu lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulajdonos: „%@”: a macOS törléskor kéri a jelszavát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di proprietà di “%@”: macOS ti chiede la password quando elimini."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Propriedade de «%@»: o macOS solicita a sua palavra-passe ao eliminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparține „%@”: macOS vă cere parola la ștergere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrí „%@“: macOS sa pri mazaní opýta na vaše heslo."
          }
