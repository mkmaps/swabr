    "Wird endgültig gelöscht, lässt sich aber jederzeit neu erzeugen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže se trvale, ale lze ji kdykoli vytvořit znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird endgültig gelöscht, lässt sich aber jederzeit neu erzeugen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφεται οριστικά, αλλά μπορεί να δημιουργηθεί ξανά ανά πάσα στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted permanently, but can be recreated at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha eliminado de forma definitiva, pero se puede volver a crear en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé définitivement, mais peut être recréé à tout moment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno izbrisano, ali se može ponovno stvoriti u bilo kojem trenutku."
