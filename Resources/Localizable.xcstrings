    "Bitte „%@“ auswählen und auf „Zugriff erlauben“ klicken. Swabr merkt sich die Freigabe.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte prosím „%@“ a klikněte na „Povolit přístup“. Swabr si oprávnění zapamatuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte „%@“ auswählen und auf „Zugriff erlauben“ klicken. Swabr merkt sich die Freigabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε «%@» και κάντε κλικ στο «Παραχώρηση πρόσβασης». Το Swabr θυμάται την άδεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select “%@” and click “Allow access”. Swabr remembers the permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona «%@» y haz clic en «Permitir acceso». Swabr recordará el permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez sélectionner « %@ » et cliquer sur « Autoriser l’accès ». Swabr mémorise cette autorisation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite „%@” i kliknite „Dopusti pristup”. Swabr pamti dozvolu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki: „%@”, és kattintson a „Hozzáférés engedélyezése” gombra. A Swabr megjegyzi az engedélyt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona “%@” e clicca su “Consenti l’accesso”. Swabr ricorderà l’autorizzazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione «%@» e clique em «Permitir acesso». O Swabr guarda esta autorização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați „%@” și faceți clic pe „Permiteți accesul”. Swabr reține permisiunea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte „%@“ a kliknite na „Povoliť prístup“. Swabr si oprávnenie zapamätá."
          }
        }
      }
    },
    "Bitte „Library“ auswählen und auf „Zugriff erlauben“ klicken, damit Swabr Systemdateien von Apps findet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte prosím „Library“ a klikněte na „Povolit přístup“, aby Swabr našel systémové soubory aplikací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte „Library“ auswählen und auf „Zugriff erlauben“ klicken, damit Swabr Systemdateien von Apps findet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε «Library» και κάντε κλικ στο «Παραχώρηση πρόσβασης» ώστε το Swabr να βρίσκει τα αρχεία συστήματος των εφαρμογών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select “Library” and click “Allow access” so Swabr can find apps' system files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona «Biblioteca» y haz clic en «Permitir acceso» para que Swabr pueda encontrar los archivos de sistema de las aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez sélectionner « Bibliothèque » et cliquer sur « Autoriser l’accès » afin que Swabr puisse localiser les fichiers système des applications."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite „Library” i kliknite „Dopusti pristup” kako bi Swabr mogao pronaći sistemske datoteke aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki a „Library” mappát, és kattintson a „Hozzáférés engedélyezése” gombra, hogy a Swabr megtalálja az appok rendszerfájljait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona “Libreria” e clicca su “Consenti l’accesso” in modo che Swabr possa individuare i file di sistema delle app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione «Biblioteca» e clique em «Permitir acesso» para que o Swabr possa localizar os ficheiros de sistema das aplicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați „Library” și faceți clic pe „Permiteți accesul” pentru ca Swabr să găsească fișierele de sistem ale aplicațiilor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte „Library“ a kliknite na „Povoliť prístup“, aby Swabr našiel systémové súbory aplikácií."
          }
        }
      }
    },
    "Bleiben standardmäßig erhalten, damit Einstellungen und Konten bei einer Neuinstallation wieder da sind. Nur angekreuzte Einträge werden entfernt.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu zůstávají, aby po přeinstalaci byla nastavení a účty zpět. Odstraní se jen zaškrtnuté položky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben standardmäßig erhalten, damit Einstellungen und Konten bei einer Neuinstallation wieder da sind. Nur angekreuzte Einträge werden entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρούνται από προεπιλογή ώστε ρυθμίσεις και λογαριασμοί να επιστρέφουν μετά από επανεγκατάσταση. Αφαιρούνται μόνο οι επιλεγμένες καταχωρίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept by default so settings and accounts are back after a reinstall. Only ticked entries are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene por defecto para que la configuración y las cuentas vuelvan a aparecer tras una reinstalación. Solo se eliminan las entradas marcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservées par défaut afin que les réglages et les comptes soient restaurés après une réinstallation. Seules les entrées cochées sont supprimées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržano prema zadanim postavkama kako bi se postavke i računi vratili nakon ponovne instalacije. Uklanjaju se samo označeni unosi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés szerint megmaradnak, hogy újratelepítés után a beállítások és fiókok visszatérjenek. Csak a bejelölt elemek törlődnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenuto di default in modo che le impostazioni e gli account tornino come prima dopo una reinstallazione. Vengono rimosse solo le voci spuntate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido por predefinição, para que as definições e as contas sejam restauradas após uma reinstalação. Apenas as entradas assinaladas são removidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrate implicit, astfel încât setările și conturile să revină după reinstalare. Sunt eliminate doar intrările bifate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolene zostávajú, aby po preinštalovaní boli nastavenia a účty späť. Odstránia sa len zaškrtnuté položky."
          }
        }
      }
    },
