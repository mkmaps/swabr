    "Endgültig löschen gibt Speicher sofort frei. Im Papierkorb lässt sich alles wiederherstellen, der Platz wird aber erst beim Leeren frei.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvalé smazání uvolní místo okamžitě. Z koše lze vše obnovit, místo se ale uvolní až po jeho vysypání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen gibt Speicher sofort frei. Im Papierkorb lässt sich alles wiederherstellen, der Platz wird aber erst beim Leeren frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οριστική διαγραφή ελευθερώνει χώρο αμέσως. Από τον Κάδο όλα μπορούν να ανακτηθούν, αλλά ο χώρος ελευθερώνεται μόνο όταν αδειάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting permanently frees space immediately. In the Trash everything can be restored, but the space is freed only when it is emptied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar algo de forma permanente, se libera espacio al instante. En la Papelera se puede recuperar todo, pero el espacio solo se libera cuando se vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression libère immédiatement de l'espace de manière définitive. Dans la Corbeille, tout peut être restauré, mais l'espace n'est libéré que lorsque celle-ci est vidée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno brisanje odmah oslobađa prostor. Iz Smeća se sve može vratiti, ali se prostor oslobađa tek pri pražnjenju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A végleges törlés azonnal felszabadítja a helyet. A Kukából minden visszaállítható, de a hely csak ürítéskor szabadul fel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione definitiva libera immediatamente spazio. Nel Cestino tutto può essere ripristinato, ma lo spazio viene liberato solo quando il Cestino viene svuotato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A eliminação definitiva liberta espaço imediatamente. No Lixo, tudo pode ser restaurado, mas o espaço só é libertado quando esta for esvaziada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea definitivă eliberează spațiul imediat. Din Coș totul poate fi restaurat, dar spațiul este eliberat doar la golire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvalé vymazanie uvoľní miesto okamžite. Z koša sa dá všetko obnoviť, miesto sa však uvoľní až po jeho vyprázdnení."
          }
        }
      }
    },
    "Endgültig: nicht wiederherstellbar. Jede Löschung wird protokolliert.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale: nelze obnovit. Každé smazání se zaznamená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig: nicht wiederherstellbar. Jede Löschung wird protokolliert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οριστικά: δεν μπορεί να ανακτηθεί. Κάθε διαγραφή καταγράφεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently: can't be restored. Every deletion is logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma permanente: no se puede recuperar. Cada eliminación queda registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De manière définitive : ne peut pas être restauré. Chaque suppression est consignée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno: ne može se vratiti. Svako brisanje se bilježi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen: nem állítható vissza. Minden törlés naplózásra kerül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modo definitivo: non può essere ripristinato. Ogni eliminazione viene registrata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma permanente: não pode ser restaurado. Cada eliminação é registada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitiv: nu poate fi restaurat. Fiecare ștergere este înregistrată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo: nedá sa obnoviť. Každé zmazanie sa zaznamená."
          }
        }
      }
    },
